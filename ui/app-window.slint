import { Button, CheckBox, LineEdit, ListView, TextEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct ConnectionEntry {
    id: string,
    name: string,
    status: string,
    status-color: color,
}

export struct Subscription {
    topic: string,
    qos: int,
}

export struct LogEntry {
    time: string,
    timestamp: string,
    kind: string,
    topic: string,
    payload: string,
}

component Segmented inherits Rectangle {
    in property <[string]> options: [];
    in-out property <int> current-index: 0;
    in property <bool> interactive: true;
    in property <length> item-width: 54px;

    callback activated(int);

    height: 28px;
    border-radius: 6px;
    background: #12141a;
    width: options.length * item-width;

    HorizontalLayout {
        for opt[index] in options: Rectangle {
            width: item-width;
            border-radius: 5px;
            background: index == current-index ? #2f6fd0 : transparent;
            opacity: interactive ? 1 : 0.45;
            Text {
                text: opt;
                color: index == current-index ? #ffffff : #9aa0a6;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 12px;
            }
            seg-touch := TouchArea {
                clicked => {
                    if (interactive) {
                        current-index = index;
                        activated(index);
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "mqttc";
    min-width: 1280px;
    min-height: 720px;
    preferred-width: 1440px;
    preferred-height: 860px;
    background: #16181d;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    in-out property <string> active-connection-id: "";
    in-out property <[ConnectionEntry]> connections: [];

    in-out property <string> connection-name: "";
    in-out property <string> host: "127.0.0.1";
    in-out property <string> port: "1883";
    in-out property <string> client-id: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> keep-alive: "60";
    in-out property <bool> clean-session: true;
    in-out property <string> connect-timeout: "10";
    in-out property <string> will-topic: "";
    in-out property <string> will-payload: "";
    in-out property <int> will-qos: 0;
    in-out property <bool> will-retain: false;
    in-out property <bool> show-advanced: false;
    in-out property <string> status: "未连接";
    in-out property <color> status-color: #9aa0a6;
    in-out property <bool> connected: false;
    in-out property <bool> connecting: false;

    in-out property <string> sub-topic: "mqttc/mvp/#";
    in-out property <int> sub-qos: 0;
    in-out property <[Subscription]> subscriptions: [];

    in-out property <string> pub-topic: "mqttc/mvp/hello";
    in-out property <string> pub-payload: "hello from mqttc";
    in-out property <int> pub-qos: 0;
    in-out property <bool> pub-retain: false;
    in-out property <int> pub-format: 0;
    in-out property <string> timed-interval: "5";
    in-out property <bool> timed-running: false;

    in-out property <[LogEntry]> logs: [];
    in-out property <int> log-format: 0;
    in-out property <bool> auto-scroll: true;
    in-out property <string> log-filter: "";
    in-out property <int> log-kind-filter: 0;
    in-out property <length> log-scroll-y: 0px;

    callback new-connection-requested();
    callback select-connection-requested(string);
    callback delete-connection-requested(string);
    callback connect-requested();
    callback disconnect-requested();
    callback subscribe-requested();
    callback unsubscribe-requested(int);
    callback publish-requested();
    callback format-payload-requested();
    callback generate-client-id-requested();
    callback advanced-toggled();
    callback timed-toggle-requested();
    callback log-format-changed();
    callback log-filter-changed();
    callback save-logs-requested();
    callback clear-logs-requested();

    HorizontalBox {
        padding: 12px;
        spacing: 12px;

        Rectangle {
            width: 248px;
            border-radius: 10px;
            background: #1e2229;
            VerticalBox {
                padding: 10px;
                spacing: 8px;
                HorizontalBox {
                    spacing: 6px;
                    Text { text: "连接"; color: #c5cad3; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 40px;
                        text: "+";
                        clicked => { root.new-connection-requested(); }
                    }
                }
                Rectangle {
                    background: #12141a;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    clip: true;
                    ListView {
                        for conn in root.connections: Rectangle {
                            height: 54px;
                            background: conn.id == root.active-connection-id ? #2b3240 : transparent;
                            row-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.select-connection-requested(conn.id); }
                            }
                            HorizontalLayout {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                padding: 8px;
                                spacing: 8px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: conn.status-color;
                                    y: (parent.height - self.height) / 2;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: conn.name;
                                        color: #e4e8ef;
                                        overflow: elide;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: conn.status;
                                        color: conn.status-color;
                                        font-size: 11px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: del-touch.has-hover ? #3a3f49 : transparent;
                                    y: (parent.height - self.height) / 2;
                                    Text {
                                        text: "×";
                                        color: #e85d5d;
                                        font-size: 15px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    del-touch := TouchArea {
                                        clicked => { root.delete-connection-requested(conn.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        VerticalBox {
            spacing: 12px;
            horizontal-stretch: 1;

            Rectangle {
                border-radius: 10px;
                background: #1e2229;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalBox {
                        spacing: 10px;
                        Text {
                            text: root.connection-name;
                            color: #f2f4f8;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            border-radius: 11px;
                            background: #242830;
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.status-color;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: root.status;
                                        color: root.status-color;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        VerticalBox {
                            spacing: 4px;
                            Text { text: "名称"; color: #8b919a; font-size: 11px; }
                            LineEdit {
                                text <=> root.connection-name;
                                placeholder-text: "连接名称";
                            }
                        }
                        VerticalBox {
                            spacing: 4px;
                            Text { text: "主机"; color: #8b919a; font-size: 11px; }
                            LineEdit {
                                text <=> root.host;
                                placeholder-text: "127.0.0.1";
                                enabled: !root.connected && !root.connecting;
                            }
                        }
                        VerticalBox {
                            spacing: 4px;
                            width: 90px;
                            Text { text: "端口"; color: #8b919a; font-size: 11px; }
                            LineEdit {
                                text <=> root.port;
                                placeholder-text: "1883";
                                enabled: !root.connected && !root.connecting;
                            }
                        }
                        VerticalBox {
                            spacing: 4px;
                            Text { text: "Client ID"; color: #8b919a; font-size: 11px; }
                            HorizontalBox {
                                spacing: 6px;
                                LineEdit {
                                    text <=> root.client-id;
                                    placeholder-text: "空则自动生成";
                                    enabled: !root.connected && !root.connecting;
                                }
                                Button {
                                    width: 52px;
                                    text: "生成";
                                    enabled: !root.connected && !root.connecting;
                                    clicked => { root.generate-client-id-requested(); }
                                }
                            }
                        }
                        VerticalBox {
                            spacing: 4px;
                            width: 92px;
                            Text { text: " "; color: transparent; font-size: 11px; }
                            Button {
                                text: "连接";
                                enabled: !root.connected && !root.connecting;
                                clicked => { root.connect-requested(); }
                            }
                        }
                        VerticalBox {
                            spacing: 4px;
                            width: 92px;
                            Text { text: " "; color: transparent; font-size: 11px; }
                            Button {
                                text: "断开";
                                enabled: root.connected || root.connecting;
                                clicked => { root.disconnect-requested(); }
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        VerticalBox {
                            spacing: 4px;
                            Text { text: "用户名"; color: #8b919a; font-size: 11px; }
                            LineEdit {
                                text <=> root.username;
                                placeholder-text: "可选，空则匿名";
                                enabled: !root.connected && !root.connecting;
                            }
                        }
                        VerticalBox {
                            spacing: 4px;
                            Text { text: "密码"; color: #8b919a; font-size: 11px; }
                             LineEdit {
                                 text <=> root.password;
                                 placeholder-text: "可选";
                                 input-type: InputType.password;
                                 enabled: !root.connected && !root.connecting;
                             }
                         }
                         VerticalBox {
                             spacing: 4px;
                             width: 92px;
                             Text { text: " "; color: transparent; font-size: 11px; }
                             Button {
                                 text: root.show-advanced ? "收起高级" : "高级参数";
                                 clicked => {
                                     root.show-advanced = !root.show-advanced;
                                     root.advanced-toggled();
                                 }
                             }
                         }
                     }
                     if root.show-advanced: VerticalBox {
                         spacing: 8px;
                         HorizontalBox {
                             spacing: 8px;
                             VerticalBox {
                                 spacing: 4px;
                                 width: 110px;
                                 Text { text: "Keep Alive"; color: #8b919a; font-size: 11px; }
                                 LineEdit {
                                     text <=> root.keep-alive;
                                     placeholder-text: "秒";
                                     enabled: !root.connected && !root.connecting;
                                 }
                             }
                             VerticalBox {
                                 spacing: 4px;
                                 width: 110px;
                                 Text { text: "超时"; color: #8b919a; font-size: 11px; }
                                 LineEdit {
                                     text <=> root.connect-timeout;
                                     placeholder-text: "秒";
                                     enabled: !root.connected && !root.connecting;
                                 }
                             }
                             VerticalBox {
                                 spacing: 4px;
                                 alignment: end;
                                 CheckBox {
                                     text: "Clean Session";
                                     checked <=> root.clean-session;
                                     enabled: !root.connected && !root.connecting;
                                 }
                             }
                             Rectangle { horizontal-stretch: 1; background: transparent; }
                         }
                         Text { text: "遗嘱消息 (Last Will)"; color: #c5cad3; font-weight: 600; }
                         HorizontalBox {
                             spacing: 8px;
                             VerticalBox {
                                 spacing: 4px;
                                 Text { text: "遗嘱 Topic"; color: #8b919a; font-size: 11px; }
                                 LineEdit {
                                     text <=> root.will-topic;
                                     placeholder-text: "留空则不发送遗嘱";
                                     enabled: !root.connected && !root.connecting;
                                 }
                             }
                             VerticalBox {
                                 spacing: 4px;
                                 Text { text: "遗嘱 Payload"; color: #8b919a; font-size: 11px; }
                                 LineEdit {
                                     text <=> root.will-payload;
                                     placeholder-text: "断开时由 Broker 代发";
                                     enabled: !root.connected && !root.connecting;
                                 }
                             }
                         }
                         HorizontalBox {
                             spacing: 8px;
                             Text { text: "遗嘱 QoS"; color: #8b919a; font-size: 11px; vertical-alignment: center; }
                             Segmented {
                                 options: ["0", "1", "2"];
                                 item-width: 42px;
                                 current-index <=> root.will-qos;
                                 interactive: !root.connected && !root.connecting;
                             }
                             CheckBox {
                                 text: "Retain";
                                 checked <=> root.will-retain;
                                 enabled: !root.connected && !root.connecting;
                             }
                             Rectangle { horizontal-stretch: 1; background: transparent; }
                         }
                     }
                 }
             }

            HorizontalBox {
                spacing: 12px;

                Rectangle {
                    border-radius: 10px;
                    background: #1e2229;
                    horizontal-stretch: 1;
                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;
                        Text { text: "订阅"; color: #c5cad3; font-weight: 600; }
                        HorizontalBox {
                            spacing: 8px;
                            LineEdit {
                                text <=> root.sub-topic;
                                placeholder-text: "topic/filter/#";
                                enabled: root.connected;
                            }
                            Button {
                                width: 92px;
                                text: "订阅";
                                enabled: root.connected;
                                clicked => { root.subscribe-requested(); }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "QoS"; color: #8b919a; font-size: 11px; vertical-alignment: center; }
                            Segmented {
                                options: ["0", "1", "2"];
                                item-width: 42px;
                                current-index <=> root.sub-qos;
                                interactive: root.connected;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: "订阅列表"; color: #8b919a; font-size: 11px; vertical-alignment: center; }
                        }
                        Rectangle {
                            background: #12141a;
                            border-radius: 6px;
                            height: 108px;
                            clip: true;
                            ListView {
                                for sub[index] in root.subscriptions: Rectangle {
                                    height: 28px;
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        Text {
                                            text: sub.topic;
                                            color: #d7dde6;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            font-family: "Consolas";
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "QoS " + sub.qos;
                                            color: #8b919a;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: cancel-touch.has-hover ? #3a3f49 : transparent;
                                            y: (parent.height - self.height) / 2;
                                            Text {
                                                text: "×";
                                                color: #e85d5d;
                                                font-size: 15px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            cancel-touch := TouchArea {
                                                clicked => { root.unsubscribe-requested(index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    border-radius: 10px;
                    background: #1e2229;
                    horizontal-stretch: 1;
                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;
                        Text { text: "发布"; color: #c5cad3; font-weight: 600; }
                        HorizontalBox {
                            spacing: 8px;
                            LineEdit {
                                text <=> root.pub-topic;
                                placeholder-text: "topic";
                                enabled: root.connected;
                            }
                            Button {
                                width: 92px;
                                text: "发布";
                                enabled: root.connected;
                                clicked => { root.publish-requested(); }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "QoS"; color: #8b919a; font-size: 11px; vertical-alignment: center; }
                            Segmented {
                                options: ["0", "1", "2"];
                                item-width: 42px;
                                current-index <=> root.pub-qos;
                                interactive: root.connected;
                            }
                            CheckBox {
                                text: "Retain";
                                checked <=> root.pub-retain;
                                enabled: root.connected;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: "格式"; color: #8b919a; font-size: 11px; vertical-alignment: center; }
                            Segmented {
                                options: ["文本", "JSON", "Base64", "Hex"];
                                item-width: 58px;
                                current-index <=> root.pub-format;
                                interactive: root.connected;
                            }
                            Button {
                                width: 68px;
                                text: "美化";
                                enabled: root.connected && root.pub-format == 1;
                                clicked => { root.format-payload-requested(); }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "定时(秒)"; color: #8b919a; font-size: 11px; vertical-alignment: center; }
                            LineEdit {
                                width: 72px;
                                text <=> root.timed-interval;
                                placeholder-text: "5";
                                enabled: root.connected && !root.timed-running;
                            }
                            Button {
                                width: 92px;
                                text: root.timed-running ? "停止" : "定时发布";
                                enabled: root.connected || root.timed-running;
                                clicked => { root.timed-toggle-requested(); }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        TextEdit {
                            text <=> root.pub-payload;
                            placeholder-text: "payload（支持多行，回车换行）";
                            enabled: root.connected;
                            wrap: word-wrap;
                            font-family: "Consolas";
                            height: 96px;
                        }
                    }
                }
            }

            Rectangle {
                border-radius: 10px;
                background: #1e2229;
                vertical-stretch: 1;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "日志"; color: #c5cad3; font-weight: 600; vertical-alignment: center; }
                        LineEdit {
                            width: 180px;
                            text <=> root.log-filter;
                            placeholder-text: "筛选 Topic / Payload";
                            edited => { root.log-filter-changed(); }
                        }
                        Segmented {
                            options: ["全部", "收", "发", "系统", "错误"];
                            item-width: 46px;
                            current-index <=> root.log-kind-filter;
                            activated(idx) => { root.log-filter-changed(); }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: "接收格式"; color: #8b919a; font-size: 11px; vertical-alignment: center; }
                        Segmented {
                            options: ["文本", "JSON", "Base64", "Hex"];
                            item-width: 58px;
                            current-index <=> root.log-format;
                            activated(idx) => { root.log-format-changed(); }
                        }
                        CheckBox {
                            text: "自动滚动";
                            checked <=> root.auto-scroll;
                        }
                        Button {
                            text: "保存日志";
                            clicked => { root.save-logs-requested(); }
                        }
                        Button {
                            text: "清空";
                            clicked => { root.clear-logs-requested(); }
                        }
                    }
                    Rectangle {
                        background: #12141a;
                        border-radius: 8px;
                        vertical-stretch: 1;
                        clip: true;
                        log-view := ListView {
                            viewport-y <=> root.log-scroll-y;
                            for entry in root.logs: Rectangle {
                                min-height: 36px;
                                background: #12141a;
                                VerticalLayout {
                                    padding-top: 5px;
                                    padding-bottom: 5px;
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    if entry.kind == "RECV": HorizontalLayout {
                                        alignment: start;
                                        Rectangle {
                                            max-width: 560px;
                                            horizontal-stretch: 0;
                                            border-radius: 10px;
                                            background: #1b2f24;
                                            VerticalLayout {
                                                padding: 8px;
                                                spacing: 4px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: entry.topic;
                                                        color: #4ecf7a;
                                                        font-family: "Consolas";
                                                        font-size: 11px;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                    }
                                                    Text {
                                                        text: entry.time;
                                                        color: #6d737c;
                                                        font-family: "Consolas";
                                                        font-size: 10px;
                                                    }
                                                }
                                                Text {
                                                    text: entry.payload;
                                                    color: #d7e8dc;
                                                    wrap: word-wrap;
                                                    font-family: "Consolas";
                                                }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    if entry.kind == "SEND": HorizontalLayout {
                                        alignment: end;
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            max-width: 560px;
                                            horizontal-stretch: 0;
                                            border-radius: 10px;
                                            background: #1d2f4a;
                                            VerticalLayout {
                                                padding: 8px;
                                                spacing: 4px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: entry.topic;
                                                        color: #5aa7ff;
                                                        font-family: "Consolas";
                                                        font-size: 11px;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                    }
                                                    Text {
                                                        text: entry.time;
                                                        color: #6d737c;
                                                        font-family: "Consolas";
                                                        font-size: 10px;
                                                    }
                                                }
                                                Text {
                                                    text: entry.payload;
                                                    color: #d5e4f7;
                                                    wrap: word-wrap;
                                                    font-family: "Consolas";
                                                }
                                            }
                                        }
                                    }
                                    if entry.kind != "RECV" && entry.kind != "SEND": HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            border-radius: 8px;
                                            background: entry.kind == "ERR" ? #3a2224 : #242830;
                                            VerticalLayout {
                                                padding: 6px;
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: center;
                                                    Text {
                                                        text: entry.time;
                                                        color: #6d737c;
                                                        font-family: "Consolas";
                                                        font-size: 10px;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: entry.kind == "ERR" ? "错误" : "系统";
                                                        color: entry.kind == "ERR" ? #e85d5d : #9aa0a6;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: entry.topic == "" ? entry.payload : entry.topic + "  " + entry.payload;
                                                        color: entry.kind == "ERR" ? #f0c4c4 : #b8c0cc;
                                                        wrap: word-wrap;
                                                        font-family: "Consolas";
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    states [
        auto-scrolling when root.auto-scroll: {
            log-scroll-y: min(0px, log-view.visible-height - log-view.viewport-height);
        }
    ]
}
