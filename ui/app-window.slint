// Single-window UI. `build.rs` compiles this file into Rust types used by `src/main.rs`.
//
// How to read it:
// 1. `struct` — rows passed from Rust (`ConnectionEntry`, `LogEntry`, …)
// 2. `global Theme` / `global I18n` — colors and bilingual strings
// 3. Small components (`Select`, `FieldLabel`, `MessageList`)
// 4. `AppWindow` — window properties, callbacks, then `if root.page == N` pages
//
// Hyphens in property names become underscores in Rust: `pub-topic` → `get_pub_topic()`.
import { AboutSlint, Button, CheckBox, LineEdit, ListView, TextEdit, VerticalBox, HorizontalBox, ScrollView, Palette } from "std-widgets.slint";

// One left-sidebar row. `status-color` is set from `ConnStatus` in Rust.
export struct ConnectionEntry {
    id: string,
    name: string,
    status: string,
    status-color: color,
}

// One subscription row. `selected` highlights the active log filter.
export struct Subscription {
    topic: string,
    qos: int,
    selected: bool,
}

// Rendered log row. Payload is already a string; raw bytes live in Rust `LogData`.
export struct LogEntry {
    time: string,
    timestamp: string,
    kind: string,
    topic: string,
    payload: string,
}

export struct PublishPresetRow {
    name: string,
    topic: string,
    payload: string,
    qos: int,
    retain: bool,
    format: int,
}

export struct AutoReplyRuleRow {
    enabled: bool,
    match-topic: string,
    payload-contains: string,
    reply-topic: string,
    reply-payload: string,
    qos: int,
    retain: bool,
    format: int,
}

// Visual palette only: 0=Dark, 1=Light, 2=Night.
// The settings combo's System (index 0) is resolved in Rust before writing `skin`.
export global Theme {
    in-out property <int> skin: 0;
    // 0=small 11px, 1=medium 12px (Windows 9pt), 2=large 14px, 3=xlarge 16px
    in-out property <int> font-size: 1;
    // 0=compact 75%, 1=standard 90%, 2=comfortable 110%
    in-out property <int> density: 1;

    pure function pick(dark: color, light: color, night: color) -> color {
        if (skin == 1) {
            return light;
        }
        if (skin == 2) {
            return night;
        }
        return dark;
    }

    out property <color> window-bg: pick(#212223, #f9fafd, #212328);
    out property <color> panel-bg: pick(#262729, #ffffff, #292b33);
    out property <color> inset-bg: pick(#1f2021, #f1f8fc, #31333f);
    out property <color> hover-bg: pick(#323232, #efefef, #393a42);
    out property <color> selected-bg: pick(#303133, #edf4fc, #394452);
    out property <color> badge-bg: pick(#303133, #f4f4f5, #31333f);
    out property <color> text-primary: pick(#ffffff, #222b3b, #ffffff);
    out property <color> text-title: pick(#d3d3d3, #222b3b, #d3d3d3);
    out property <color> text-muted: pick(#a3a3a3, #616161, #a2a9b0);
    out property <color> text-faint: pick(#b4b4b4, #a2a9b0, #b4b4b4);
    out property <color> text-body: pick(#d3d3d3, #616161, #d3d3d3);
    out property <color> accent: #34c388;
    out property <color> accent-fg: #ffffff;
    out property <color> muted: pick(#9ea3b1, #a2a9b0, #9ea3b1);
    out property <color> recv-bg: pick(#303133, #ebf8f2, #31333f);
    out property <color> recv-topic: pick(#53daa2, #34c388, #53daa2);
    out property <color> recv-payload: pick(#d3d3d3, #222b3b, #d3d3d3);
    out property <color> send-bg: pick(#1b3d32, #34c388, #1b3d32);
    out property <color> send-topic: pick(#53daa2, #ffffff, #53daa2);
    out property <color> send-payload: pick(#d3d3d3, #ffffff, #d3d3d3);
    out property <color> sys-bg: pick(#303133, #edeef3, #31333f);
    out property <color> sys-text: pick(#a3a3a3, #616161, #a2a9b0);
    out property <color> err-bg: pick(#3a2224, #fcdee4, #3a2224);
    out property <color> err-label: pick(#f56c6c, #f56c6c, #f56c6c);
    out property <color> err-text: pick(#fcdee4, #7a1f1f, #fcdee4);
    out property <color> danger: pick(#f56c6c, #f56c6c, #f56c6c);
    out property <color> sub-selected: pick(#1b3d32, #ebf8f2, #394452);
    out property <color> nav-bg: pick(#1f2122, #ffffff, #212328);
    out property <color> nav-top: pick(#232325, #f9fafd, #292b33);
    out property <color> nav-item: pick(#1f2021, #f1f8fc, #31333f);
    out property <color> nav-text: pick(#d3d3d3, #222b3b, #d3d3d3);
    out property <color> nav-muted: pick(#868787, #616161, #83929b);
    out property <color> nav-selected: pick(#303133, #edf4fc, #394452);
    out property <color> nav-hover: pick(#323232, #efefef, #393a42);
    in-out property <string> ui-font: "Microsoft YaHei UI";
    in-out property <string> mono-font: "Cascadia Mono";

    public pure function font-px() -> int {
        if (font-size == 0) {
            return 11;
        }
        if (font-size == 2) {
            return 14;
        }
        if (font-size == 3) {
            return 16;
        }
        return 12;
    }

    public pure function dens-pct() -> int {
        if (density == 0) {
            return 75;
        }
        if (density == 2) {
            return 110;
        }
        return 90;
    }

    public pure function sz(base: int) -> length {
        return 1px * base * font-px() * dens-pct() / 1400;
    }

    out property <length> font-xs: 1px * max(9, font-px() - 2);
    out property <length> font-sm: 1px * max(10, font-px() - 1);
    out property <length> font-md: 1px * font-px();
    out property <length> font-base: 1px * font-px();
    out property <length> font-lg: 1px * (font-px() + 1);
    out property <length> font-title: 1px * (font-px() + 1);
    out property <length> font-hero: 1px * (font-px() + 6);

    out property <length> space-1: sz(2);
    out property <length> space-2: sz(4);
    out property <length> space-3: sz(6);
    out property <length> space-4: sz(8);
    out property <length> space-5: sz(10);
    out property <length> space-6: sz(12);
    out property <length> space-7: sz(16);
    out property <length> space-8: sz(18);

    out property <length> control-h: max(32px, sz(32));
    out property <length> menu-item-h: max(20px, sz(24));
    out property <length> row-conn: max(36px, sz(48));
    out property <length> row-sub: max(32px, sz(40));
    out property <length> payload-h: max(40px, sz(48));
    out property <length> icon-btn: max(18px, sz(20));
    out property <length> sidebar-w: max(132px, sz(168));
    out property <length> nav-w: max(160px, sz(200));
    out property <length> sub-panel-w: max(160px, sz(220));
    out property <length> window-min-w: max(560px, sz(880));
    out property <length> window-min-h: max(420px, sz(600));
    out property <length> window-pref-w: max(880px, sz(1200));
    out property <length> window-pref-h: max(560px, sz(760));
}

// language 0 = 中文, 1 = English. Widgets call `I18n.t("中文", "English")`.
export global I18n {
    in-out property <int> language: 0;

    public pure function t(zh: string, en: string) -> string {
        if (language == 1) {
            return en;
        }
        return zh;
    }
}

// Compact combo. `options` is the label list; `current-index` is the integer Rust stores.
component Select inherits Rectangle {
    in property <[string]> options: [];
    in-out property <int> current-index: 0;
    in property <bool> interactive: true;
    callback activated(int);

    height: Theme.control-h;
    width: 72px;
    border-radius: 6px;
    background: Theme.inset-bg;
    opacity: interactive ? 1 : 0.45;

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-3;
        spacing: Theme.space-1;
        Text {
            text: current-index >= 0 && current-index < options.length ? options[current-index] : "";
            color: Theme.text-body;
            font-family: Theme.ui-font;
            font-size: Theme.font-md;
            font-weight: 500;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: "v";
            color: Theme.text-muted;
            font-family: Theme.ui-font;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            if (interactive) {
                menu.show();
            }
        }
    }

    menu := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: max(root.width, 88px);
        Rectangle {
            background: Theme.panel-bg;
            border-radius: 6px;
            VerticalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-1;
                for opt[index] in root.options: Rectangle {
                    height: Theme.menu-item-h;
                    border-radius: 4px;
                    background: item-touch.has-hover ? Theme.hover-bg : (index == root.current-index ? Theme.selected-bg : transparent);
                    Text {
                        text: opt;
                        color: Theme.text-body;
                        font-family: Theme.ui-font;
                        font-size: Theme.font-md;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        x: 8px;
                        width: parent.width - 16px;
                        overflow: elide;
                    }
                    item-touch := TouchArea {
                        clicked => {
                            root.current-index = index;
                            root.activated(index);
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

component FieldLabel inherits Text {
    in property <string> caption;
    text: caption;
    color: Theme.text-muted;
    font-family: Theme.ui-font;
    font-size: Theme.font-sm;
    font-weight: 500;
    vertical-alignment: center;
}

component Field inherits LineEdit {
    min-width: 0px;
    min-height: Theme.control-h;
    preferred-height: Theme.control-h;
    max-height: Theme.control-h;
    font-size: Theme.font-md;
    horizontal-alignment: left;
    vertical-stretch: 0;
}

// Chat-style log. `content-y` is Slint 1.18 (older tutorials still say `viewport-y`).
component MessageList inherits Rectangle {
    in-out property <[LogEntry]> logs: [];
    in-out property <bool> auto-scroll: true;

    background: Theme.inset-bg;
    border-radius: 8px;
    clip: true;

    // Flickable content-y is 0 at the top and negative when scrolled down.
    function scroll-to-bottom() {
        if (root.auto-scroll) {
            log-view.content-y = min(0px, log-view.height - log-view.content-height);
        }
    }

    changed auto-scroll => {
        root.scroll-to-bottom();
    }
    changed logs => {
        if (root.auto-scroll) {
            stick-timer.running = false;
            stick-timer.running = true;
        }
    }

    stick-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.scroll-to-bottom();
        }
    }

    log-view := Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: max(self.height, content.preferred-height);

        changed content-height => {
            root.scroll-to-bottom();
        }
        changed height => {
            root.scroll-to-bottom();
        }

        content := VerticalLayout {
            width: 100%;
            height: self.preferred-height;
            alignment: start;
            spacing: 0px;
            for entry in root.logs: Rectangle {
                width: 100%;
                vertical-stretch: 0;
                height: self.preferred-height;
                background: Theme.inset-bg;
                VerticalLayout {
                    padding-top: Theme.sz(5);
                    padding-bottom: Theme.sz(5);
                    padding-left: Theme.space-5;
                    padding-right: Theme.space-5;
                    if entry.kind == "RECV": HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            max-width: 520px;
                            horizontal-stretch: 0;
                            border-radius: 10px;
                            background: Theme.recv-bg;
                            VerticalLayout {
                                padding: Theme.space-4;
                                spacing: Theme.space-2;
                                HorizontalLayout {
                                    spacing: Theme.space-4;
                                    Text {
                                        text: entry.topic;
                                        color: Theme.recv-topic;
                                        font-family: Theme.mono-font;
                                        font-size: Theme.font-md;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: entry.time;
                                        color: Theme.text-faint;
                                        font-family: Theme.mono-font;
                                        font-size: Theme.font-sm;
                                    }
                                }
                                Text {
                                    text: entry.payload;
                                    color: Theme.recv-payload;
                                    wrap: word-wrap;
                                    font-family: Theme.mono-font;
                                    font-size: Theme.font-md;
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    if entry.kind == "SEND": HorizontalLayout {
                        alignment: end;
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            max-width: 520px;
                            horizontal-stretch: 0;
                            border-radius: 10px;
                            background: Theme.send-bg;
                            VerticalLayout {
                                padding: Theme.space-4;
                                spacing: Theme.space-2;
                                HorizontalLayout {
                                    spacing: Theme.space-4;
                                    Text {
                                        text: entry.topic;
                                        color: Theme.send-topic;
                                        font-family: Theme.mono-font;
                                        font-size: Theme.font-md;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: entry.time;
                                        color: Theme.text-faint;
                                        font-family: Theme.mono-font;
                                        font-size: Theme.font-sm;
                                    }
                                }
                                Text {
                                    text: entry.payload;
                                    color: Theme.send-payload;
                                    wrap: word-wrap;
                                    font-family: Theme.mono-font;
                                    font-size: Theme.font-md;
                                }
                            }
                        }
                    }
                    if entry.kind != "RECV" && entry.kind != "SEND": HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            border-radius: 8px;
                            background: entry.kind == "ERR" ? Theme.err-bg : Theme.sys-bg;
                            VerticalLayout {
                                padding: Theme.space-3;
                                padding-left: Theme.space-5;
                                padding-right: Theme.space-5;
                                HorizontalLayout {
                                    spacing: Theme.space-4;
                                    alignment: center;
                                    Text {
                                        text: entry.time;
                                        color: Theme.text-faint;
                                        font-family: Theme.mono-font;
                                        font-size: Theme.font-sm;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: entry.kind == "ERR" ? I18n.t("错误", "Error") : I18n.t("系统", "System");
                                        color: entry.kind == "ERR" ? Theme.err-label : Theme.muted;
                                        font-family: Theme.ui-font;
                                        font-size: Theme.font-sm;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: entry.topic == "" ? entry.payload : entry.topic + "  " + entry.payload;
                                        color: entry.kind == "ERR" ? Theme.err-text : Theme.sys-text;
                                        wrap: word-wrap;
                                        font-family: Theme.mono-font;
                                        font-size: Theme.font-md;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// page: 0 = connection editor, 1 = live session, 2 = settings, 3 = auto-reply, 4 = publish presets, 5 = about.
export component AppWindow inherits Window {
    title: "mqttc";
    icon: @image-url("../assets/icon.png");
    min-width: Theme.window-min-w;
    min-height: Theme.window-min-h;
    preferred-width: Theme.window-pref-w;
    preferred-height: Theme.window-pref-h;
    background: Theme.window-bg;
    default-font-family: Theme.ui-font;
    default-font-size: Theme.font-base;
    default-font-weight: 400;

    // 0 config, 1 session, 2 settings, 3 auto-reply, 4 presets, 5 about.
    in-out property <int> page: 0;
    in-out property <string> active-connection-id: "";
    in-out property <[ConnectionEntry]> connections: [];
    in-out property <string> connection-summary: "127.0.0.1:1883";

    in-out property <string> connection-name: "";
    in-out property <string> host: "127.0.0.1";
    in-out property <string> port: "1883";
    in-out property <string> client-id: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    // 0 = MQTT 3.1.1, 1 = MQTT 5.0
    in-out property <int> mqtt-protocol: 0;
    in-out property <string> keep-alive: "60";
    in-out property <bool> clean-session: true;
    in-out property <string> connect-timeout: "10";
    in-out property <string> will-topic: "";
    in-out property <string> will-payload: "";
    in-out property <int> will-qos: 0;
    in-out property <bool> will-retain: false;
    in-out property <bool> ssl: false;
    in-out property <bool> ssl-verify: true;
    in-out property <string> ssl-ca: "";
    in-out property <string> ssl-cert: "";
    in-out property <string> ssl-key: "";
    in-out property <string> status: "Disconnected";
    in-out property <color> status-color: #9aa0a6;
    in-out property <bool> connected: false;
    in-out property <bool> connecting: false;

    in-out property <string> sub-topic: "mqttc/mvp/#";
    in-out property <int> sub-qos: 0;
    in-out property <[Subscription]> subscriptions: [];
    in-out property <string> active-sub-topic: "";
    in-out property <bool> subscribe-open: false;
    in-out property <bool> subs-visible: true;

    in-out property <string> pub-topic: "mqttc/mvp/hello";
    in-out property <string> pub-payload: "hello from mqttc";
    in-out property <int> pub-qos: 0;
    in-out property <bool> pub-retain: false;
    in-out property <int> pub-format: 0;
    in-out property <string> timed-interval: "5";
    in-out property <bool> timed-running: false;
    in-out property <[PublishPresetRow]> publish-presets: [];
    in-out property <[AutoReplyRuleRow]> auto-reply-rules: [];
    // 0 = skip own echo, 1 = rematch own echo
    in-out property <int> auto-reply-echo: 0;

    in-out property <[LogEntry]> logs: [];
    in-out property <int> log-format: 0;
    in-out property <bool> auto-scroll: true;
    in-out property <string> log-filter: "";
    in-out property <int> log-kind-filter: 0;
    // `<=>` keeps the window property and the global in sync both ways.
    in-out property <int> skin <=> Theme.skin;
    // Stored preference including System. Theme.skin is the resolved visual index.
    in-out property <int> skin-choice: 0;
    in-out property <int> language <=> I18n.language;
    in-out property <int> font-size <=> Theme.font-size;
    in-out property <int> density <=> Theme.density;
    in-out property <string> ui-font <=> Theme.ui-font;
    in-out property <string> mono-font <=> Theme.mono-font;
    in-out property <string> app-version: "0.0.0";

    init => {
        Palette.color-scheme = skin == 1 ? ColorScheme.light : ColorScheme.dark;
    }

    changed skin => {
        Palette.color-scheme = skin == 1 ? ColorScheme.light : ColorScheme.dark;
    }

    changed skin-choice => {
        root.skin-changed();
    }

    changed language => {
        root.language-changed();
    }

    changed font-size => {
        root.ui-scale-changed();
    }

    changed density => {
        root.ui-scale-changed();
    }

    changed subs-visible => {
        root.subs-visible-changed();
    }

    callback new-connection-requested();
    callback select-connection-requested(string);
    callback delete-connection-requested(string);
    callback edit-connection-requested();
    callback back-to-session-requested();
    callback connect-requested();
    callback disconnect-requested();
    callback subscribe-requested();
    callback unsubscribe-requested(int);
    callback filter-subscription-requested(string);
    callback publish-requested();
    callback preset-publish-requested(int);
    callback format-payload-requested();
    callback generate-client-id-requested();
    callback timed-toggle-requested();
    callback log-format-changed();
    callback log-filter-changed();
    callback save-logs-requested();
    callback clear-logs-requested();
    callback skin-changed();
    callback language-changed();
    callback ui-scale-changed();
    callback subs-visible-changed();
    callback settings-requested();
    callback about-requested();
    callback auto-reply-requested();
    callback add-auto-reply-requested();
    callback delete-auto-reply-requested(int);
    callback publish-presets-requested();
    callback add-publish-preset-requested();
    callback delete-publish-preset-requested(int);

    Rectangle {
        clip: true;
        min-width: 0px;
        HorizontalBox {
        padding: Theme.space-6;
        spacing: Theme.space-6;
        min-width: 0px;

        Rectangle {
            min-width: 120px;
            preferred-width: Theme.nav-w;
            border-radius: 10px;
            background: Theme.nav-bg;
            VerticalBox {
                padding: Theme.space-4;
                spacing: Theme.space-4;
                HorizontalBox {
                    spacing: Theme.space-3;
                    Text { text: I18n.t("连接", "Conns"); color: Theme.nav-text; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 32px;
                        text: "+";
                        clicked => { root.new-connection-requested(); }
                    }
                }
                Rectangle {
                    background: Theme.nav-item;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    clip: true;
                    ListView {
                        for conn in root.connections: Rectangle {
                            height: Theme.row-conn;
                            background: conn.id == root.active-connection-id ? Theme.nav-selected : transparent;
                            row-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.select-connection-requested(conn.id); }
                            }
                            HorizontalLayout {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                padding: Theme.space-3;
                                spacing: Theme.space-3;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: conn.status-color;
                                    y: (parent.height - self.height) / 2;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: Theme.space-1;
                                    Text {
                                        text: conn.name;
                                        color: Theme.nav-text;
                                        overflow: elide;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: conn.status;
                                        color: conn.status-color;
                                        font-size: Theme.font-sm;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Rectangle {
                                    width: Theme.icon-btn;
                                    height: Theme.icon-btn;
                                    border-radius: Theme.icon-btn / 2;
                                    background: del-touch.has-hover ? Theme.nav-hover : transparent;
                                    y: (parent.height - self.height) / 2;
                                    Text {
                                        text: "×";
                                        color: Theme.danger;
                                        font-size: Theme.font-lg;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    del-touch := TouchArea {
                                        clicked => { root.delete-connection-requested(conn.id); }
                                    }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: Theme.space-2;
                    nav-auto := Rectangle {
                        height: Theme.control-h;
                        border-radius: 6px;
                        background: root.page == 3 ? Theme.nav-selected : (nav-auto-touch.has-hover ? Theme.nav-hover : transparent);
                        Text {
                            text: I18n.t("自动回复", "Auto-reply");
                            color: Theme.nav-text;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        nav-auto-touch := TouchArea {
                            clicked => { root.auto-reply-requested(); }
                        }
                    }
                    nav-preset := Rectangle {
                        height: Theme.control-h;
                        border-radius: 6px;
                        background: root.page == 4 ? Theme.nav-selected : (nav-preset-touch.has-hover ? Theme.nav-hover : transparent);
                        Text {
                            text: I18n.t("发布预设", "Presets");
                            color: Theme.nav-text;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        nav-preset-touch := TouchArea {
                            clicked => { root.publish-presets-requested(); }
                        }
                    }
                    nav-set := Rectangle {
                        height: Theme.control-h;
                        border-radius: 6px;
                        background: root.page == 2 ? Theme.nav-selected : (nav-set-touch.has-hover ? Theme.nav-hover : transparent);
                        Text {
                            text: I18n.t("设置", "Settings");
                            color: Theme.nav-text;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        nav-set-touch := TouchArea {
                            clicked => { root.settings-requested(); }
                        }
                    }
                    nav-about := Rectangle {
                        height: Theme.control-h;
                        border-radius: 6px;
                        background: root.page == 5 ? Theme.nav-selected : (nav-about-touch.has-hover ? Theme.nav-hover : transparent);
                        Text {
                            text: I18n.t("关于", "About");
                            color: Theme.nav-text;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        nav-about-touch := TouchArea {
                            clicked => { root.about-requested(); }
                        }
                    }
                }
            }
        }

        if root.page == 2: Rectangle {
            border-radius: 10px;
            background: Theme.panel-bg;
            horizontal-stretch: 1;
            min-width: 0px;
            VerticalBox {
                padding: Theme.space-7;
                spacing: Theme.space-6;
                HorizontalBox {
                    spacing: Theme.space-5;
                    Text {
                        text: I18n.t("设置", "Settings");
                        color: Theme.text-primary;
                        font-size: Theme.font-title;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 88px;
                        text: I18n.t("返回会话", "Back");
                        clicked => { root.back-to-session-requested(); }
                    }
                }
                VerticalBox {
                    spacing: Theme.space-8;
                    Text { text: I18n.t("外观", "Appearance"); color: Theme.text-title; font-weight: 600; }
                    HorizontalBox {
                        spacing: Theme.space-6;
                        FieldLabel { caption: I18n.t("皮肤", "Skin"); }
                        Select {
                            width: 148px;
                            options: [
                                I18n.t("跟随系统", "System"),
                                I18n.t("浅色", "Light"),
                                I18n.t("深色", "Dark"),
                                I18n.t("夜间", "Night"),
                            ];
                            current-index <=> root.skin-choice;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    HorizontalBox {
                        spacing: Theme.space-6;
                        FieldLabel { caption: I18n.t("字号", "Font size"); }
                        Select {
                            width: 148px;
                            options: [
                                I18n.t("小", "Small"),
                                I18n.t("中", "Medium"),
                                I18n.t("大", "Large"),
                                I18n.t("特大", "Extra large"),
                            ];
                            current-index <=> root.font-size;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    HorizontalBox {
                        spacing: Theme.space-6;
                        FieldLabel { caption: I18n.t("界面密度", "Density"); }
                        Select {
                            width: 148px;
                            options: [
                                I18n.t("紧凑", "Compact"),
                                I18n.t("标准", "Standard"),
                                I18n.t("宽松", "Comfortable"),
                            ];
                            current-index <=> root.density;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    Text { text: I18n.t("语言", "Language"); color: Theme.text-title; font-weight: 600; }
                    HorizontalBox {
                        spacing: Theme.space-6;
                        FieldLabel { caption: I18n.t("界面语言", "UI language"); }
                        Select {
                            width: 140px;
                            options: ["中文", "English"];
                            current-index <=> root.language;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    Text {
                        text: I18n.t("切换立即生效，并写入 mqttc.json。缩小窗口时可用小字号与紧凑密度。", "Changes apply immediately and are saved to mqttc.json. Use small type and compact density for a smaller window.");
                        color: Theme.text-faint;
                        font-size: Theme.font-sm;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }

        if root.page == 3: Rectangle {
            border-radius: 10px;
            background: Theme.panel-bg;
            min-width: 0px;
            horizontal-stretch: 1;
            VerticalBox {
                padding: Theme.space-7;
                spacing: Theme.space-6;
                HorizontalBox {
                    spacing: Theme.space-5;
                    Text {
                        text: I18n.t("自动回复", "Auto-reply");
                        color: Theme.text-primary;
                        font-size: Theme.font-title;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 88px;
                        text: I18n.t("返回会话", "Back");
                        clicked => { root.back-to-session-requested(); }
                    }
                }
                HorizontalBox {
                    spacing: Theme.space-6;
                    FieldLabel { caption: I18n.t("自身回投", "Own echo"); }
                    Select {
                        width: Theme.sub-panel-w;
                        options: [
                            I18n.t("跳过自身回投", "Skip own echo"),
                            I18n.t("再匹配自身回投", "Rematch own echo"),
                        ];
                        current-index <=> root.auto-reply-echo;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        text: I18n.t("新增规则", "Add rule");
                        clicked => { root.add-auto-reply-requested(); }
                    }
                }
                Text {
                    text: I18n.t("勾选后该条才参与匹配；同一条消息只触发第一条命中的规则。", "Only checked rules match; the first hit sends its own fixed reply.");
                    color: Theme.text-faint;
                    font-size: Theme.font-sm;
                }
                Rectangle {
                    background: Theme.inset-bg;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    clip: true;
                    if root.auto-reply-rules.length == 0: Text {
                        text: I18n.t("还没有规则。点「新增规则」添加。", "No rules yet. Click Add rule.");
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ListView {
                        for rule[index] in root.auto-reply-rules: Rectangle {
                            height: 148px;
                            VerticalLayout {
                                padding: Theme.space-5;
                                spacing: Theme.space-3;
                                HorizontalBox {
                                    padding: 0;
                                    spacing: Theme.space-4;
                                    CheckBox {
                                        text: I18n.t("启用", "On");
                                        checked <=> rule.enabled;
                                    }
                                    Text {
                                        text: I18n.t("规则", "Rule");
                                        color: Theme.text-title;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Button {
                                        width: 64px;
                                        text: I18n.t("删除", "Delete");
                                        clicked => { root.delete-auto-reply-requested(index); }
                                    }
                                }
                                HorizontalBox {
                                    padding: 0;
                                    spacing: Theme.space-4;
                                    FieldLabel { caption: I18n.t("匹配 Topic", "Match topic"); width: 88px; }
                                    Field {
                                        text <=> rule.match-topic;
                                        placeholder-text: "sensor/+/status";
                                        horizontal-stretch: 1;
                                    }
                                    FieldLabel { caption: I18n.t("包含", "Contains"); width: 48px; }
                                    Field {
                                        text <=> rule.payload-contains;
                                        placeholder-text: I18n.t("可选", "optional");
                                        preferred-width: 160px;
                                    }
                                }
                                HorizontalBox {
                                    padding: 0;
                                    spacing: Theme.space-4;
                                    FieldLabel { caption: I18n.t("回复 Topic", "Reply topic"); width: 88px; }
                                    Field {
                                        text <=> rule.reply-topic;
                                        placeholder-text: "Topic";
                                        horizontal-stretch: 1;
                                    }
                                    Select {
                                        width: 52px;
                                        options: ["0", "1", "2"];
                                        current-index <=> rule.qos;
                                    }
                                    CheckBox {
                                        text: "Retain";
                                        checked <=> rule.retain;
                                    }
                                    Select {
                                        width: 78px;
                                        options: [
                                            I18n.t("文本", "Text"),
                                            "JSON",
                                            "Base64",
                                            "Hex",
                                        ];
                                        current-index <=> rule.format;
                                    }
                                }
                                TextEdit {
                                    text <=> rule.reply-payload;
                                    placeholder-text: "Payload";
                                    wrap: word-wrap;
                                    font-family: Theme.mono-font;
                                    height: Theme.row-sub;
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.page == 4: Rectangle {
            min-width: 0px;
            border-radius: 10px;
            background: Theme.panel-bg;
            horizontal-stretch: 1;
            VerticalBox {
                padding: Theme.space-7;
                spacing: Theme.space-6;
                HorizontalBox {
                    spacing: Theme.space-5;
                    Text {
                        text: I18n.t("发布预设", "Publish presets");
                        color: Theme.text-primary;
                        font-size: Theme.font-title;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 88px;
                        text: I18n.t("返回会话", "Back");
                        clicked => { root.back-to-session-requested(); }
                    }
                }
                HorizontalBox {
                    spacing: Theme.space-6;
                    Text {
                        text: I18n.t("在会话页发布区下方点发送即可发出对应报文。", "Send from the session page under the publish form.");
                        color: Theme.text-faint;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        text: I18n.t("新增预设", "Add preset");
                        clicked => { root.add-publish-preset-requested(); }
                    }
                }
                Rectangle {
                    background: Theme.inset-bg;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    clip: true;
                    if root.publish-presets.length == 0: Text {
                        text: I18n.t("还没有预设。点「新增预设」添加。", "No presets yet. Click Add preset.");
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ListView {
                        for preset[index] in root.publish-presets: Rectangle {
                            height: 148px;
                            VerticalLayout {
                                padding: Theme.space-5;
                                spacing: Theme.space-3;
                                HorizontalBox {
                                    padding: 0;
                                    spacing: Theme.space-4;
                                    Field {
                                        preferred-width: 140px;
                                        text <=> preset.name;
                                        placeholder-text: I18n.t("名称", "Name");
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Button {
                                        width: 64px;
                                        text: I18n.t("删除", "Delete");
                                        clicked => { root.delete-publish-preset-requested(index); }
                                    }
                                }
                                HorizontalBox {
                                    padding: 0;
                                    spacing: Theme.space-4;
                                    FieldLabel { caption: I18n.t("Topic", "Topic"); width: 48px; }
                                    Field {
                                        text <=> preset.topic;
                                        placeholder-text: "Topic";
                                        horizontal-stretch: 1;
                                    }
                                    Select {
                                        width: 52px;
                                        options: ["0", "1", "2"];
                                        current-index <=> preset.qos;
                                    }
                                    CheckBox {
                                        text: "Retain";
                                        checked <=> preset.retain;
                                    }
                                    Select {
                                        width: 78px;
                                        options: [
                                            I18n.t("文本", "Text"),
                                            "JSON",
                                            "Base64",
                                            "Hex",
                                        ];
                                        current-index <=> preset.format;
                                    }
                                }
                                TextEdit {
                                    text <=> preset.payload;
                                    placeholder-text: "Payload";
                                    wrap: word-wrap;
                                    font-family: Theme.mono-font;
                                    height: Theme.payload-h;
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.page == 5: Rectangle {
            border-radius: 10px;
            background: Theme.panel-bg;
            horizontal-stretch: 1;
            min-width: 0px;
            VerticalBox {
                padding: Theme.space-7;
                spacing: Theme.space-6;
                HorizontalBox {
                    spacing: Theme.space-5;
                    Text {
                        text: I18n.t("关于", "About");
                        color: Theme.text-primary;
                        font-size: Theme.font-title;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 88px;
                        text: I18n.t("返回会话", "Back");
                        clicked => { root.back-to-session-requested(); }
                    }
                }
                VerticalBox {
                    spacing: Theme.space-6;
                    Text {
                        text: "mqttc";
                        color: Theme.text-primary;
                        font-size: Theme.font-hero;
                        font-weight: 700;
                    }
                    Text {
                        text: I18n.t("版本 ", "Version ") + root.app-version;
                        color: Theme.text-muted;
                        font-size: Theme.font-md;
                    }
                    Text {
                        text: I18n.t(
                            "跨平台桌面 MQTT 调试客户端，界面参考 MQTTX。同一套代码覆盖 Windows、macOS 与 Linux。",
                            "A cross-platform desktop MQTT debug client inspired by MQTTX. One codebase covers Windows, macOS, and Linux."
                        );
                        color: Theme.text-body;
                        wrap: word-wrap;
                    }
                    Text {
                        text: I18n.t("能做什么", "What it does");
                        color: Theme.text-title;
                        font-weight: 600;
                    }
                    Text {
                        text: I18n.t(
                            "同时维护多条 Broker 连接，订阅 Topic、发布消息、查看聊天气泡日志。每条连接可配置发布预设与自动回复。协议支持 MQTT 3.1.1 与 MQTT 5.0，可选 TLS。",
                            "Keep several Broker connections online at once. Subscribe, publish, and watch chat-style logs. Each connection has its own publish presets and auto-reply rules. MQTT 3.1.1 and 5.0, with optional TLS."
                        );
                        color: Theme.text-body;
                        wrap: word-wrap;
                    }
                    Text {
                        text: I18n.t("说明", "Notes");
                        color: Theme.text-title;
                        font-weight: 600;
                    }
                    Text {
                        text: I18n.t(
                            "MQTTX 很好用。发起本项目，是为了得到一份拷贝即可运行、体积和内存占用更小的桌面客户端。连接、皮肤与语言写入可执行文件同目录的 mqttc.json。日志上限每连接 200 条。Windows 与 Linux 提供预编译文件；macOS 需在本机编译。",
                            "MQTTX is a great tool. mqttc started as a copy-and-run desktop MQTT debug client with a smaller binary and a lighter memory footprint. Connections, skin, and language are saved to mqttc.json next to the executable. Each connection keeps up to 200 log rows in memory. Windows and Linux ship prebuilt binaries; macOS must be compiled on a Mac."
                        );
                        color: Theme.text-body;
                        wrap: word-wrap;
                    }
                    Text {
                        text: I18n.t("开源协议", "License");
                        color: Theme.text-title;
                        font-weight: 600;
                    }
                    Text {
                        text: I18n.t(
                            "MIT License。源码仓库根目录有 LICENSE 全文。Copyright (c) 2026 Gordon Wen。",
                            "MIT License. The full text is in LICENSE at the repository root. Copyright (c) 2026 Gordon Wen."
                        );
                        color: Theme.text-body;
                        wrap: word-wrap;
                    }
                    AboutSlint {
                        height: 72px;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }

        if root.page == 0: Rectangle {
            border-radius: 10px;
            background: Theme.panel-bg;
            horizontal-stretch: 1;
            min-width: 0px;
            VerticalBox {
                padding: Theme.space-7;
                spacing: Theme.space-6;
                HorizontalBox {
                    spacing: Theme.space-5;
                    Text {
                        text: I18n.t("连接配置", "Connection");
                        color: Theme.text-primary;
                        font-size: Theme.font-title;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.connection-name;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 88px;
                        text: I18n.t("返回会话", "Back");
                        clicked => { root.back-to-session-requested(); }
                    }
                    Button {
                        width: 88px;
                        text: I18n.t("连接", "Connect");
                        enabled: !root.connected && !root.connecting;
                        clicked => { root.connect-requested(); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalBox {
                        padding-right: Theme.space-4;
                        spacing: Theme.sz(14);
                        Text { text: I18n.t("基础信息", "General"); color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: Theme.space-5;
                            VerticalBox {
                                spacing: Theme.space-2;
                                width: Theme.sub-panel-w;
                                FieldLabel { caption: I18n.t("名称", "Name"); }
                                Field {
                                    text <=> root.connection-name;
                                    placeholder-text: I18n.t("连接名称", "Connection name");
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: Theme.space-2;
                                width: Theme.sub-panel-w;
                                FieldLabel { caption: I18n.t("主机", "Host"); }
                                Field {
                                    text <=> root.host;
                                    placeholder-text: "127.0.0.1";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: Theme.space-2;
                                width: 100px;
                                FieldLabel { caption: I18n.t("端口", "Port"); }
                                Field {
                                    text <=> root.port;
                                    placeholder-text: "1883";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: Theme.space-2;
                                width: 100px;
                                FieldLabel { caption: I18n.t("MQTT 协议", "MQTT protocol"); }
                                Select {
                                    width: 100px;
                                    options: ["3.1.1", "5.0"];
                                    current-index <=> root.mqtt-protocol;
                                    interactive: !root.connected && !root.connecting;
                                }
                            }
                        }
                        HorizontalBox {
                            spacing: Theme.space-5;
                            VerticalBox {
                                spacing: Theme.space-2;
                                FieldLabel { caption: "Client ID"; }
                                HorizontalBox {
                                    spacing: Theme.space-3;
                                    Field {
                                        text <=> root.client-id;
                                        placeholder-text: I18n.t("空则自动生成", "Empty = auto");
                                        enabled: !root.connected && !root.connecting;
                                    }
                                    Button {
                                        width: 52px;
                                        text: I18n.t("生成", "Gen");
                                        enabled: !root.connected && !root.connecting;
                                        clicked => { root.generate-client-id-requested(); }
                                    }
                                }
                            }
                            VerticalBox {
                                spacing: Theme.space-2;
                                FieldLabel { caption: I18n.t("用户名", "Username"); }
                                Field {
                                    text <=> root.username;
                                    placeholder-text: I18n.t("可选，空则匿名", "Optional, empty = anonymous");
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: Theme.space-2;
                                FieldLabel { caption: I18n.t("密码", "Password"); }
                                Field {
                                    text <=> root.password;
                                    placeholder-text: I18n.t("可选", "Optional");
                                    input-type: InputType.password;
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                        }
                        Text { text: I18n.t("高级参数", "Advanced"); color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: Theme.space-5;
                            VerticalBox {
                                spacing: Theme.space-2;
                                width: 140px;
                                FieldLabel { caption: I18n.t("Keep Alive (秒)", "Keep Alive (s)"); }
                                Field {
                                    text <=> root.keep-alive;
                                    placeholder-text: "60";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: Theme.space-2;
                                width: 140px;
                                FieldLabel { caption: I18n.t("连接超时 (秒)", "Timeout (s)"); }
                                Field {
                                    text <=> root.connect-timeout;
                                    placeholder-text: "10";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: Theme.space-2;
                                alignment: end;
                                CheckBox {
                                    text: "Clean Session";
                                    checked <=> root.clean-session;
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Text { text: "SSL / TLS"; color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: Theme.space-5;
                            CheckBox {
                                text: I18n.t("启用 SSL", "Enable SSL");
                                checked <=> root.ssl;
                                enabled: !root.connected && !root.connecting;
                                toggled => {
                                    if (root.ssl && root.port == "1883") {
                                        root.port = "8883";
                                    }
                                    if (!root.ssl && root.port == "8883") {
                                        root.port = "1883";
                                    }
                                }
                            }
                            CheckBox {
                                text: I18n.t("校验服务器证书", "Verify certificate");
                                checked <=> root.ssl-verify;
                                enabled: root.ssl && !root.connected && !root.connecting;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        if root.ssl: VerticalBox {
                            spacing: Theme.space-5;
                            HorizontalBox {
                                spacing: Theme.space-5;
                                VerticalBox {
                                    spacing: Theme.space-2;
                                    FieldLabel { caption: I18n.t("CA 证书路径", "CA certificate"); }
                                    Field {
                                        text <=> root.ssl-ca;
                                        placeholder-text: I18n.t("可选，空则使用系统 CA", "Optional, empty = system CA");
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                            }
                            HorizontalBox {
                                spacing: Theme.space-5;
                                VerticalBox {
                                    spacing: Theme.space-2;
                                    FieldLabel { caption: I18n.t("客户端证书", "Client cert"); }
                                    Field {
                                        text <=> root.ssl-cert;
                                        placeholder-text: I18n.t("可选，双向认证时填写", "Optional, for mutual TLS");
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                                VerticalBox {
                                    spacing: Theme.space-2;
                                    FieldLabel { caption: I18n.t("客户端私钥", "Client key"); }
                                    Field {
                                        text <=> root.ssl-key;
                                        placeholder-text: I18n.t("可选，与证书成对", "Optional, pair with cert");
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                            }
                            Text {
                                text: I18n.t("端口常用 8883。关闭校验仅用于自签证书调试。", "Port 8883 is common. Turn off verify only for self-signed certs.");
                                color: Theme.text-faint;
                                font-size: Theme.font-sm;
                            }
                        }
                        Text { text: I18n.t("遗嘱消息 (Last Will)", "Last Will"); color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: Theme.space-5;
                            VerticalBox {
                                spacing: Theme.space-2;
                                FieldLabel { caption: I18n.t("遗嘱 Topic", "Will topic"); }
                                Field {
                                    text <=> root.will-topic;
                                    placeholder-text: I18n.t("留空则不发送遗嘱", "Empty = no will");
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: Theme.space-2;
                                FieldLabel { caption: I18n.t("遗嘱 Payload", "Will payload"); }
                                Field {
                                    text <=> root.will-payload;
                                    placeholder-text: I18n.t("异常断开时由 Broker 代发", "Sent by broker on unexpected disconnect");
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                        }
                        HorizontalBox {
                            spacing: Theme.space-4;
                            Text { text: I18n.t("遗嘱 QoS", "Will QoS"); color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                            Select {
                                width: 56px;
                                options: ["0", "1", "2"];
                                current-index <=> root.will-qos;
                                interactive: !root.connected && !root.connecting;
                            }
                            CheckBox {
                                text: "Retain";
                                checked <=> root.will-retain;
                                enabled: !root.connected && !root.connecting;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                }
            }
        }

        if root.page == 1: VerticalLayout {
            padding: 0;
            spacing: Theme.space-6;
            horizontal-stretch: 1;
            vertical-stretch: 1;
            min-width: 0px;

            Rectangle {
                border-radius: 10px;
                background: Theme.panel-bg;
                clip: true;
                min-width: 0px;
                VerticalBox {
                    padding: Theme.space-6;
                    spacing: Theme.space-4;
                    Rectangle {
                        min-width: 0px;
                        width: 100%;
                        height: max(Theme.control-h, header-bar.preferred-height);
                        clip: true;
                    Flickable {
                        width: 100%;
                        height: 100%;
                        content-height: self.height;
                        content-width: max(self.width, header-bar.preferred-width);
                        header-bar := HorizontalLayout {
                        padding: 0;
                        spacing: Theme.space-5;
                        width: self.preferred-width;
                        height: 100%;
                        alignment: center;
                        Text {
                            text: root.connection-name;
                            color: Theme.text-primary;
                            font-size: Theme.font-title;
                            font-weight: 700;
                            vertical-alignment: center;
                            height: 100%;
                            overflow: elide;
                        }
                        Text {
                            text: root.connection-summary;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            height: 100%;
                            overflow: elide;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                         Rectangle {
                             height: 100%;
                             border-radius: Theme.control-h / 2;
                             background: Theme.badge-bg;
                             HorizontalLayout {
                                 padding-left: Theme.space-5;
                                 padding-right: Theme.space-5;
                                 spacing: Theme.space-3;
                                 alignment: center;
                                 Rectangle {
                                     width: 8px;
                                     height: 8px;
                                     border-radius: 4px;
                                     background: root.status-color;
                                     y: (parent.height - self.height) / 2;
                                 }
                                 Text {
                                     text: root.status;
                                     color: root.status-color;
                                     font-weight: 600;
                                     vertical-alignment: center;
                                     height: 100%;
                                 }
                             }
                         }
                        Button {
                            width: 72px;
                            text: I18n.t("编辑", "Edit");
                            enabled: !root.connecting;
                            clicked => { root.edit-connection-requested(); }
                        }
                        Button {
                            width: 72px;
                            text: I18n.t("连接", "Connect");
                            enabled: !root.connected && !root.connecting;
                            clicked => { root.connect-requested(); }
                        }
                        Button {
                            width: 72px;
                            text: I18n.t("断开", "Disconnect");
                            enabled: root.connected || root.connecting;
                            clicked => { root.disconnect-requested(); }
                        }
                        if !root.subs-visible: Button {
                            width: 88px;
                            text: I18n.t("订阅列表", "Subs");
                            clicked => { root.subs-visible = true; }
                        }
                        }
                    }
                    }
                }
            }

            VerticalLayout {
                    padding: 0;
                    spacing: Theme.space-6;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    min-width: 0px;

                    HorizontalLayout {
                        padding: 0;
                        spacing: Theme.space-6;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        min-width: 0px;

                        if root.subs-visible: Rectangle {
                            border-radius: 10px;
                            background: Theme.panel-bg;
                            preferred-width: Theme.sub-panel-w;
                            min-width: 0px;
                            horizontal-stretch: 0;
                            vertical-stretch: 1;
                            clip: true;
                            VerticalBox {
                                padding: Theme.space-4;
                                spacing: Theme.space-3;
                                HorizontalBox {
                                    spacing: Theme.space-3;
                                    Text {
                                        text: I18n.t("订阅", "Subscriptions");
                                        color: Theme.text-title;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Button {
                                        width: 56px;
                                        text: I18n.t("隐藏", "Hide");
                                        clicked => { root.subs-visible = false; }
                                    }
                                }
                                Rectangle {
                                    background: Theme.inset-bg;
                                    border-radius: 8px;
                                    vertical-stretch: 1;
                                    min-width: 0px;
                                    clip: true;
                                    ListView {
                                        for sub[index] in root.subscriptions: Rectangle {
                                            height: Theme.row-sub;
                                            background: sub.selected ? Theme.sub-selected : transparent;
                                            sub-row-touch := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                clicked => { root.filter-subscription-requested(sub.topic); }
                                            }
                                            HorizontalLayout {
                                                x: 0;
                                                y: 0;
                                                width: parent.width;
                                                height: parent.height;
                                                padding-left: Theme.space-3;
                                                padding-right: Theme.space-2;
                                                spacing: Theme.space-2;
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: Theme.space-1;
                                                    Text {
                                                        text: sub.topic;
                                                        color: sub.selected ? Theme.accent : Theme.text-body;
                                                        font-family: Theme.mono-font;
                                                        font-size: Theme.font-sm;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: "QoS " + sub.qos;
                                                        color: Theme.text-muted;
                                                        font-size: Theme.font-xs;
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                                Rectangle {
                                                    width: Theme.icon-btn;
                                                    height: Theme.icon-btn;
                                                    border-radius: Theme.icon-btn / 2;
                                                    background: sub-cancel.has-hover ? Theme.hover-bg : transparent;
                                                    y: (parent.height - self.height) / 2;
                                                    Text {
                                                        text: "×";
                                                        color: Theme.danger;
                                                        font-size: Theme.font-lg;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    sub-cancel := TouchArea {
                                                        clicked => { root.unsubscribe-requested(index); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.subscribe-open: VerticalBox {
                                    padding: 0;
                                    spacing: Theme.space-3;
                                     Field {
                                         text <=> root.sub-topic;
                                        placeholder-text: "topic/filter/#";
                                        enabled: root.connected;
                                    }
                                    HorizontalBox {
                                        spacing: Theme.space-3;
                                        Text { text: "QoS"; color: Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                                        Select {
                                            width: 56px;
                                            options: ["0", "1", "2"];
                                            current-index <=> root.sub-qos;
                                            interactive: root.connected;
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    HorizontalBox {
                                        spacing: Theme.space-3;
                                        Button {
                                            horizontal-stretch: 1;
                                            text: I18n.t("订阅", "Sub");
                                            enabled: root.connected;
                                            clicked => { root.subscribe-requested(); }
                                        }
                                        Button {
                                            width: 64px;
                                            text: I18n.t("取消", "Cancel");
                                            clicked => { root.subscribe-open = false; }
                                        }
                                    }
                                }
                                if !root.subscribe-open: Button {
                                    text: I18n.t("新建订阅", "New Subscription");
                                    enabled: root.connected;
                                    clicked => { root.subscribe-open = true; }
                                }
                            }
                        }

                    Rectangle {
                        border-radius: 10px;
                        background: Theme.panel-bg;
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        clip: true;
                        min-width: 0px;
                        VerticalBox {
                            padding: Theme.space-6;
                            spacing: Theme.space-4;
                            Rectangle {
                                min-width: 0px;
                                width: 100%;
                                height: max(Theme.control-h, log-bar.preferred-height);
                                clip: true;
                            Flickable {
                                width: 100%;
                                height: 100%;
                                content-height: self.height;
                                content-width: max(self.width, log-bar.preferred-width);
                            log-bar := HorizontalLayout {
                                padding: 0;
                                spacing: Theme.space-4;
                                width: self.preferred-width;
                                height: 100%;
                                alignment: center;
                                Text { text: I18n.t("消息", "Messages"); color: Theme.text-title; font-weight: 600; vertical-alignment: center; height: 100%; }
                                Field {
                                    preferred-width: 148px;
                                    text <=> root.log-filter;
                                    placeholder-text: I18n.t("搜索 Topic / Payload", "Search topic / payload");
                                    edited => { root.log-filter-changed(); }
                                }
                                Select {
                                    width: 72px;
                                    options: [
                                        I18n.t("全部", "All"),
                                        I18n.t("收", "In"),
                                        I18n.t("发", "Out"),
                                        I18n.t("系统", "Sys"),
                                        I18n.t("错误", "Err"),
                                    ];
                                    current-index <=> root.log-kind-filter;
                                    activated(idx) => { root.log-filter-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Select {
                                    width: 78px;
                                    options: [
                                        I18n.t("文本", "Text"),
                                        "JSON",
                                        "Base64",
                                        "Hex",
                                    ];
                                    current-index <=> root.log-format;
                                    activated(idx) => { root.log-format-changed(); }
                                }
                                CheckBox {
                                    text: I18n.t("自动滚动", "Auto-scroll");
                                    checked <=> root.auto-scroll;
                                }
                                Button {
                                    text: I18n.t("保存", "Save");
                                    clicked => { root.save-logs-requested(); }
                                }
                                Button {
                                    text: I18n.t("清空", "Clear");
                                    clicked => { root.clear-logs-requested(); }
                                }
                            }
                            }
                            }
                            MessageList {
                                logs <=> root.logs;
                                auto-scroll <=> root.auto-scroll;
                                vertical-stretch: 1;
                            }
                        }
                    }
                    }

                    Rectangle {
                        border-radius: 10px;
                        background: Theme.panel-bg;
                        vertical-stretch: 0;
                        clip: true;
                        min-width: 0px;
                        VerticalLayout {
                            padding: Theme.space-6;
                            spacing: Theme.space-4;
                            Rectangle {
                                min-width: 0px;
                                width: 100%;
                                height: max(Theme.control-h, pub-bar.preferred-height);
                                clip: true;
                            Flickable {
                                width: 100%;
                                height: 100%;
                                content-height: self.height;
                                content-width: max(self.width, pub-bar.preferred-width);
                            pub-bar := HorizontalLayout {
                                padding: 0;
                                spacing: Theme.space-4;
                                width: self.preferred-width;
                                height: 100%;
                                alignment: center;
                                Text { text: I18n.t("发布", "Publish"); color: Theme.text-title; font-weight: 600; vertical-alignment: center; height: 100%; }
                                 Field {
                                     preferred-width: 96px;
                                     text <=> root.pub-topic;
                                    placeholder-text: "Topic";
                                    enabled: root.connected;
                                }
                                Select {
                                    width: 52px;
                                    options: ["0", "1", "2"];
                                    current-index <=> root.pub-qos;
                                    interactive: root.connected;
                                }
                                CheckBox {
                                    text: "Retain";
                                    checked <=> root.pub-retain;
                                    enabled: root.connected;
                                }
                                Select {
                                    width: 78px;
                                    options: [
                                        I18n.t("文本", "Text"),
                                        "JSON",
                                        "Base64",
                                        "Hex",
                                    ];
                                    current-index <=> root.pub-format;
                                    interactive: root.connected;
                                }
                                Button {
                                    width: 52px;
                                    text: I18n.t("美化", "Pretty");
                                    enabled: root.connected && root.pub-format == 1;
                                    clicked => { root.format-payload-requested(); }
                                }
                                Field {
                                    preferred-width: 44px;
                                    text <=> root.timed-interval;
                                    placeholder-text: I18n.t("秒", "sec");
                                    enabled: root.connected && !root.timed-running;
                                }
                                Button {
                                    width: 72px;
                                    text: root.timed-running ? I18n.t("停止", "Stop") : I18n.t("定时", "Timed");
                                    enabled: root.connected || root.timed-running;
                                    clicked => { root.timed-toggle-requested(); }
                                }
                                Button {
                                    width: 64px;
                                    text: I18n.t("发布", "Pub");
                                    enabled: root.connected;
                                    clicked => { root.publish-requested(); }
                                }
                            }
                            }
                            }
                            TextEdit {
                                text <=> root.pub-payload;
                                placeholder-text: "Payload";
                                enabled: root.connected;
                                wrap: word-wrap;
                                font-family: Theme.mono-font;
                                height: Theme.payload-h;
                            }
                            if root.publish-presets.length > 0: HorizontalBox {
                                padding: 0;
                                spacing: Theme.space-4;
                                vertical-stretch: 0;
                                Text {
                                    text: I18n.t("发布预设", "Presets");
                                    color: Theme.text-title;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: Theme.control-h;
                                    clip: true;
                                    Flickable {
                                        width: 100%;
                                        height: 100%;
                                        content-height: self.height;
                                        content-width: max(self.width, preset-buttons.preferred-width);
                                        preset-buttons := HorizontalLayout {
                                            padding: 0;
                                            spacing: Theme.space-4;
                                            height: 100%;
                                            width: self.preferred-width;
                                            alignment: start;
                                            for preset[index] in root.publish-presets: Button {
                                                min-width: 72px;
                                                text: preset.name == "" ? (I18n.language == 1 ? "Preset \{index + 1}" : "预设 \{index + 1}") : preset.name;
                                                enabled: root.connected;
                                                clicked => { root.preset-publish-requested(index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                 }
             }
         }
        }
    }
