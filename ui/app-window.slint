import { Button, CheckBox, LineEdit, ListView, TextEdit, VerticalBox, HorizontalBox, ScrollView, Palette } from "std-widgets.slint";

export struct ConnectionEntry {
    id: string,
    name: string,
    status: string,
    status-color: color,
}

export struct Subscription {
    topic: string,
    qos: int,
    selected: bool,
}

export struct LogEntry {
    time: string,
    timestamp: string,
    kind: string,
    topic: string,
    payload: string,
}

export global Theme {
    in-out property <int> skin: 0;

    pure function pick(black: color, white: color, blue: color, green: color, purple: color) -> color {
        if (skin == 1) {
            return white;
        }
        if (skin == 2) {
            return blue;
        }
        if (skin == 3) {
            return green;
        }
        if (skin == 4) {
            return purple;
        }
        return black;
    }

    out property <color> window-bg: pick(#16181d, #e8edf3, #072048, #062820, #2a1248);
    out property <color> panel-bg: pick(#1e2229, #ffffff, #0d2d5c, #0d3830, #3c1c64);
    out property <color> inset-bg: pick(#12141a, #f3f6fa, #051830, #041c18, #1c0c34);
    out property <color> hover-bg: pick(#3a3f49, #e4eaf2, #164070, #145048, #553088);
    out property <color> selected-bg: pick(#2b3240, #d7e6f8, #18508c, #186058, #6438a0);
    out property <color> badge-bg: pick(#242830, #e7ecf3, #123a68, #104440, #482870);
    out property <color> text-primary: pick(#f2f4f8, #1c2430, #eaf3ff, #e0faf4, #f4ecff);
    out property <color> text-title: pick(#c5cad3, #334155, #8eb8e8, #8ed4c4, #cbb0f0);
    out property <color> text-muted: pick(#8b919a, #5b6573, #5d8fc4, #5aaa9a, #a888d0);
    out property <color> text-faint: pick(#6d737c, #7a8491, #4674a8, #3e8878, #8668b0);
    out property <color> text-body: pick(#e4e8ef, #1c2430, #c2d8f2, #b8e8dc, #e4d4f8);
    out property <color> accent: pick(#2f6fd0, #2f6fd0, #4d9fff, #2ec4a0, #a78bfa);
    out property <color> accent-fg: #ffffff;
    out property <color> muted: pick(#9aa0a6, #6b7280, #6a96c8, #6ab8a8, #b49ae0);
    out property <color> recv-bg: pick(#1b2f24, #e4f6ea, #0c2e32, #0e4034, #1b2f24);
    out property <color> recv-topic: pick(#4ecf7a, #1f8a4c, #4ecf7a, #3ee0b8, #4ecf7a);
    out property <color> recv-payload: pick(#d7e8dc, #1a3d28, #d7e8dc, #c8f0e4, #d7e8dc);
    out property <color> send-bg: pick(#1d2f4a, #e4eefc, #123a68, #0e3848, #3c2468);
    out property <color> send-topic: pick(#5aa7ff, #1d5fbf, #7ab8ff, #5ad4e8, #c4b5fd);
    out property <color> send-payload: pick(#d5e4f7, #1a2d4a, #d5e4f7, #c8eef4, #e8defa);
    out property <color> sys-bg: pick(#242830, #e7ecf3, #123a68, #104440, #482870);
    out property <color> sys-text: pick(#b8c0cc, #3d4654, #c5d6ee, #b8e8dc, #e4d4f8);
    out property <color> err-bg: pick(#3a2224, #fde8e8, #3a2224, #3a2224, #3a2224);
    out property <color> err-label: pick(#e85d5d, #c62828, #e85d5d, #e85d5d, #e85d5d);
    out property <color> err-text: pick(#f0c4c4, #7a1f1f, #f0c4c4, #f0c4c4, #f0c4c4);
    out property <color> danger: pick(#e85d5d, #c62828, #e85d5d, #e85d5d, #e85d5d);
    out property <color> sub-selected: pick(#243248, #d7e6f8, #18508c, #186058, #6438a0);
    in-out property <string> ui-font: "Microsoft YaHei UI";
    in-out property <string> mono-font: "Cascadia Mono";
}

export global I18n {
    in-out property <int> language: 0;

    public pure function t(zh: string, en: string) -> string {
        if (language == 1) {
            return en;
        }
        return zh;
    }
}

component Select inherits Rectangle {
    in property <[string]> options: [];
    in-out property <int> current-index: 0;
    in property <bool> interactive: true;
    callback activated(int);

    height: 28px;
    width: 72px;
    border-radius: 6px;
    background: Theme.inset-bg;
    opacity: interactive ? 1 : 0.45;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 2px;
        Text {
            text: current-index >= 0 && current-index < options.length ? options[current-index] : "";
            color: Theme.text-body;
            font-family: Theme.ui-font;
            font-size: 13px;
            font-weight: 500;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: "v";
            color: Theme.text-muted;
            font-family: Theme.ui-font;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            if (interactive) {
                menu.show();
            }
        }
    }

    menu := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: max(root.width, 88px);
        Rectangle {
            background: Theme.panel-bg;
            border-radius: 6px;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                for opt[index] in root.options: Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: item-touch.has-hover ? Theme.hover-bg : (index == root.current-index ? Theme.selected-bg : transparent);
                    Text {
                        text: opt;
                        color: Theme.text-body;
                        font-family: Theme.ui-font;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        x: 8px;
                        width: parent.width - 16px;
                        overflow: elide;
                    }
                    item-touch := TouchArea {
                        clicked => {
                            root.current-index = index;
                            root.activated(index);
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

component FieldLabel inherits Text {
    in property <string> caption;
    text: caption;
    color: Theme.text-muted;
    font-family: Theme.ui-font;
    font-size: 12px;
    font-weight: 500;
}

component MessageList inherits Rectangle {
    in-out property <[LogEntry]> logs: [];
    in-out property <bool> auto-scroll: true;

    background: Theme.inset-bg;
    border-radius: 8px;
    clip: true;

    function scroll-to-bottom() {
        if (root.auto-scroll) {
            log-view.viewport-y = min(0px, log-view.height - log-view.viewport-height);
        }
    }

    changed auto-scroll => {
        root.scroll-to-bottom();
    }
    changed logs => {
        if (root.auto-scroll) {
            stick-timer.running = false;
            stick-timer.running = true;
        }
    }

    stick-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.scroll-to-bottom();
        }
    }

    log-view := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: max(self.height, content.preferred-height);

        changed viewport-height => {
            root.scroll-to-bottom();
        }
        changed height => {
            root.scroll-to-bottom();
        }

        content := VerticalLayout {
            width: 100%;
            height: self.preferred-height;
            alignment: start;
            spacing: 0px;
            for entry in root.logs: Rectangle {
                width: 100%;
                vertical-stretch: 0;
                height: self.preferred-height;
                background: Theme.inset-bg;
                VerticalLayout {
                    padding-top: 5px;
                    padding-bottom: 5px;
                    padding-left: 10px;
                    padding-right: 10px;
                    if entry.kind == "RECV": HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            max-width: 520px;
                            horizontal-stretch: 0;
                            border-radius: 10px;
                            background: Theme.recv-bg;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: entry.topic;
                                        color: Theme.recv-topic;
                                        font-family: Theme.mono-font;
                                        font-size: 13px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: entry.time;
                                        color: Theme.text-faint;
                                        font-family: Theme.mono-font;
                                        font-size: 12px;
                                    }
                                }
                                Text {
                                    text: entry.payload;
                                    color: Theme.recv-payload;
                                    wrap: word-wrap;
                                    font-family: Theme.mono-font;
                                    font-size: 13px;
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    if entry.kind == "SEND": HorizontalLayout {
                        alignment: end;
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            max-width: 520px;
                            horizontal-stretch: 0;
                            border-radius: 10px;
                            background: Theme.send-bg;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: entry.topic;
                                        color: Theme.send-topic;
                                        font-family: Theme.mono-font;
                                        font-size: 13px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: entry.time;
                                        color: Theme.text-faint;
                                        font-family: Theme.mono-font;
                                        font-size: 12px;
                                    }
                                }
                                Text {
                                    text: entry.payload;
                                    color: Theme.send-payload;
                                    wrap: word-wrap;
                                    font-family: Theme.mono-font;
                                    font-size: 13px;
                                }
                            }
                        }
                    }
                    if entry.kind != "RECV" && entry.kind != "SEND": HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            border-radius: 8px;
                            background: entry.kind == "ERR" ? Theme.err-bg : Theme.sys-bg;
                            VerticalLayout {
                                padding: 6px;
                                padding-left: 10px;
                                padding-right: 10px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    Text {
                                        text: entry.time;
                                        color: Theme.text-faint;
                                        font-family: Theme.mono-font;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: entry.kind == "ERR" ? I18n.t("错误", "Error") : I18n.t("系统", "System");
                                        color: entry.kind == "ERR" ? Theme.err-label : Theme.muted;
                                        font-family: Theme.ui-font;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: entry.topic == "" ? entry.payload : entry.topic + "  " + entry.payload;
                                        color: entry.kind == "ERR" ? Theme.err-text : Theme.sys-text;
                                        wrap: word-wrap;
                                        font-family: Theme.mono-font;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "mqttc";
    icon: @image-url("../assets/icon.png");
    min-width: 1180px;
    min-height: 720px;
    preferred-width: 1360px;
    preferred-height: 860px;
    background: Theme.window-bg;
    default-font-family: Theme.ui-font;
    default-font-size: 14px;
    default-font-weight: 500;

    in-out property <int> page: 0;
    in-out property <string> active-connection-id: "";
    in-out property <[ConnectionEntry]> connections: [];
    in-out property <string> connection-summary: "127.0.0.1:1883";

    in-out property <string> connection-name: "";
    in-out property <string> host: "127.0.0.1";
    in-out property <string> port: "1883";
    in-out property <string> client-id: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <int> mqtt-protocol: 0;
    in-out property <string> keep-alive: "60";
    in-out property <bool> clean-session: true;
    in-out property <string> connect-timeout: "10";
    in-out property <string> will-topic: "";
    in-out property <string> will-payload: "";
    in-out property <int> will-qos: 0;
    in-out property <bool> will-retain: false;
    in-out property <bool> ssl: false;
    in-out property <bool> ssl-verify: true;
    in-out property <string> ssl-ca: "";
    in-out property <string> ssl-cert: "";
    in-out property <string> ssl-key: "";
    in-out property <string> status: "Disconnected";
    in-out property <color> status-color: #9aa0a6;
    in-out property <bool> connected: false;
    in-out property <bool> connecting: false;

    in-out property <string> sub-topic: "mqttc/mvp/#";
    in-out property <int> sub-qos: 0;
    in-out property <[Subscription]> subscriptions: [];
    in-out property <string> active-sub-topic: "";

    in-out property <string> pub-topic: "mqttc/mvp/hello";
    in-out property <string> pub-payload: "hello from mqttc";
    in-out property <int> pub-qos: 0;
    in-out property <bool> pub-retain: false;
    in-out property <int> pub-format: 0;
    in-out property <string> timed-interval: "5";
    in-out property <bool> timed-running: false;

    in-out property <[LogEntry]> logs: [];
    in-out property <int> log-format: 0;
    in-out property <bool> auto-scroll: true;
    in-out property <string> log-filter: "";
    in-out property <int> log-kind-filter: 0;
    in-out property <int> skin <=> Theme.skin;
    in-out property <int> skin-choice: 0;
    in-out property <int> language <=> I18n.language;
    in-out property <string> ui-font <=> Theme.ui-font;
    in-out property <string> mono-font <=> Theme.mono-font;

    init => {
        Palette.color-scheme = skin == 1 ? ColorScheme.light : ColorScheme.dark;
    }

    changed skin => {
        Palette.color-scheme = skin == 1 ? ColorScheme.light : ColorScheme.dark;
    }

    changed skin-choice => {
        root.skin-changed();
    }

    changed language => {
        root.language-changed();
    }

    callback new-connection-requested();
    callback select-connection-requested(string);
    callback delete-connection-requested(string);
    callback edit-connection-requested();
    callback back-to-session-requested();
    callback connect-requested();
    callback disconnect-requested();
    callback subscribe-requested();
    callback unsubscribe-requested(int);
    callback filter-subscription-requested(string);
    callback publish-requested();
    callback format-payload-requested();
    callback generate-client-id-requested();
    callback timed-toggle-requested();
    callback log-format-changed();
    callback log-filter-changed();
    callback save-logs-requested();
    callback clear-logs-requested();
    callback skin-changed();
    callback language-changed();
    callback settings-requested();

    HorizontalBox {
        padding: 12px;
        spacing: 12px;

        Rectangle {
            width: 188px;
            border-radius: 10px;
            background: Theme.panel-bg;
            VerticalBox {
                padding: 8px;
                spacing: 8px;
                HorizontalBox {
                    spacing: 6px;
                    Text { text: I18n.t("连接", "Conns"); color: Theme.text-title; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 32px;
                        text: "+";
                        clicked => { root.new-connection-requested(); }
                    }
                }
                Rectangle {
                    background: Theme.inset-bg;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    clip: true;
                    ListView {
                        for conn in root.connections: Rectangle {
                            height: 54px;
                            background: conn.id == root.active-connection-id ? Theme.selected-bg : transparent;
                            row-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.select-connection-requested(conn.id); }
                            }
                            HorizontalLayout {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                padding: 6px;
                                spacing: 6px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: conn.status-color;
                                    y: (parent.height - self.height) / 2;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: conn.name;
                                        color: Theme.text-body;
                                        overflow: elide;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: conn.status;
                                        color: conn.status-color;
                                        font-size: 12px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: del-touch.has-hover ? Theme.hover-bg : transparent;
                                    y: (parent.height - self.height) / 2;
                                    Text {
                                        text: "×";
                                        color: Theme.danger;
                                        font-size: 15px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    del-touch := TouchArea {
                                        clicked => { root.delete-connection-requested(conn.id); }
                                    }
                                }
                            }
                        }
                    }
                }
                Button {
                    text: I18n.t("设置", "Settings");
                    clicked => { root.settings-requested(); }
                }
            }
        }

        if root.page == 2: Rectangle {
            border-radius: 10px;
            background: Theme.panel-bg;
            horizontal-stretch: 1;
            VerticalBox {
                padding: 16px;
                spacing: 16px;
                HorizontalBox {
                    spacing: 10px;
                    Text {
                        text: I18n.t("设置", "Settings");
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 88px;
                        text: I18n.t("返回会话", "Back");
                        clicked => { root.back-to-session-requested(); }
                    }
                }
                VerticalBox {
                    spacing: 18px;
                    Text { text: I18n.t("外观", "Appearance"); color: Theme.text-title; font-weight: 600; }
                    HorizontalBox {
                        spacing: 12px;
                        FieldLabel { caption: I18n.t("皮肤", "Skin"); }
                        Select {
                            width: 148px;
                            options: [
                                I18n.t("跟随系统", "System"),
                                I18n.t("黑", "Black"),
                                I18n.t("白", "White"),
                                I18n.t("蓝", "Blue"),
                                I18n.t("绿", "Green"),
                                I18n.t("紫", "Purple"),
                            ];
                            current-index <=> root.skin-choice;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    Text { text: I18n.t("语言", "Language"); color: Theme.text-title; font-weight: 600; }
                    HorizontalBox {
                        spacing: 12px;
                        FieldLabel { caption: I18n.t("界面语言", "UI language"); }
                        Select {
                            width: 140px;
                            options: ["中文", "English"];
                            current-index <=> root.language;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    Text {
                        text: I18n.t("语言切换立即生效，并写入 mqttc.json。", "Language applies immediately and is saved to mqttc.json.");
                        color: Theme.text-faint;
                        font-size: 12px;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }

        if root.page == 0: Rectangle {
            border-radius: 10px;
            background: Theme.panel-bg;
            horizontal-stretch: 1;
            VerticalBox {
                padding: 16px;
                spacing: 12px;
                HorizontalBox {
                    spacing: 10px;
                    Text {
                        text: I18n.t("连接配置", "Connection");
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.connection-name;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 88px;
                        text: I18n.t("返回会话", "Back");
                        clicked => { root.back-to-session-requested(); }
                    }
                    Button {
                        width: 88px;
                        text: I18n.t("连接", "Connect");
                        enabled: !root.connected && !root.connecting;
                        clicked => { root.connect-requested(); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalBox {
                        padding-right: 8px;
                        spacing: 14px;
                        Text { text: I18n.t("基础信息", "General"); color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                width: 220px;
                                FieldLabel { caption: I18n.t("名称", "Name"); }
                                LineEdit {
                                    text <=> root.connection-name;
                                    placeholder-text: I18n.t("连接名称", "Connection name");
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                width: 220px;
                                FieldLabel { caption: I18n.t("主机", "Host"); }
                                LineEdit {
                                    text <=> root.host;
                                    placeholder-text: "127.0.0.1";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                width: 100px;
                                FieldLabel { caption: I18n.t("端口", "Port"); }
                                LineEdit {
                                    text <=> root.port;
                                    placeholder-text: "1883";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                width: 100px;
                                FieldLabel { caption: I18n.t("MQTT 协议", "MQTT protocol"); }
                                Select {
                                    width: 100px;
                                    height: 32px;
                                    options: ["3.1.1", "5.0"];
                                    current-index <=> root.mqtt-protocol;
                                    interactive: !root.connected && !root.connecting;
                                }
                            }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "Client ID"; }
                                HorizontalBox {
                                    spacing: 6px;
                                    LineEdit {
                                        text <=> root.client-id;
                                        placeholder-text: I18n.t("空则自动生成", "Empty = auto");
                                        enabled: !root.connected && !root.connecting;
                                    }
                                    Button {
                                        width: 52px;
                                        text: I18n.t("生成", "Gen");
                                        enabled: !root.connected && !root.connecting;
                                        clicked => { root.generate-client-id-requested(); }
                                    }
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: I18n.t("用户名", "Username"); }
                                LineEdit {
                                    text <=> root.username;
                                    placeholder-text: I18n.t("可选，空则匿名", "Optional, empty = anonymous");
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: I18n.t("密码", "Password"); }
                                LineEdit {
                                    text <=> root.password;
                                    placeholder-text: I18n.t("可选", "Optional");
                                    input-type: InputType.password;
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                        }
                        Text { text: I18n.t("高级参数", "Advanced"); color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                width: 140px;
                                FieldLabel { caption: I18n.t("Keep Alive (秒)", "Keep Alive (s)"); }
                                LineEdit {
                                    text <=> root.keep-alive;
                                    placeholder-text: "60";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                width: 140px;
                                FieldLabel { caption: I18n.t("连接超时 (秒)", "Timeout (s)"); }
                                LineEdit {
                                    text <=> root.connect-timeout;
                                    placeholder-text: "10";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                alignment: end;
                                CheckBox {
                                    text: "Clean Session";
                                    checked <=> root.clean-session;
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Text { text: "SSL / TLS"; color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            CheckBox {
                                text: I18n.t("启用 SSL", "Enable SSL");
                                checked <=> root.ssl;
                                enabled: !root.connected && !root.connecting;
                                toggled => {
                                    if (root.ssl && root.port == "1883") {
                                        root.port = "8883";
                                    }
                                    if (!root.ssl && root.port == "8883") {
                                        root.port = "1883";
                                    }
                                }
                            }
                            CheckBox {
                                text: I18n.t("校验服务器证书", "Verify certificate");
                                checked <=> root.ssl-verify;
                                enabled: root.ssl && !root.connected && !root.connecting;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        if root.ssl: VerticalBox {
                            spacing: 10px;
                            HorizontalBox {
                                spacing: 10px;
                                VerticalBox {
                                    spacing: 4px;
                                    FieldLabel { caption: I18n.t("CA 证书路径", "CA certificate"); }
                                    LineEdit {
                                        text <=> root.ssl-ca;
                                        placeholder-text: I18n.t("可选，空则使用系统 CA", "Optional, empty = system CA");
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                            }
                            HorizontalBox {
                                spacing: 10px;
                                VerticalBox {
                                    spacing: 4px;
                                    FieldLabel { caption: I18n.t("客户端证书", "Client cert"); }
                                    LineEdit {
                                        text <=> root.ssl-cert;
                                        placeholder-text: I18n.t("可选，双向认证时填写", "Optional, for mutual TLS");
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                                VerticalBox {
                                    spacing: 4px;
                                    FieldLabel { caption: I18n.t("客户端私钥", "Client key"); }
                                    LineEdit {
                                        text <=> root.ssl-key;
                                        placeholder-text: I18n.t("可选，与证书成对", "Optional, pair with cert");
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                            }
                            Text {
                                text: I18n.t("端口常用 8883。关闭校验仅用于自签证书调试。", "Port 8883 is common. Turn off verify only for self-signed certs.");
                                color: Theme.text-faint;
                                font-size: 12px;
                            }
                        }
                        Text { text: I18n.t("遗嘱消息 (Last Will)", "Last Will"); color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: I18n.t("遗嘱 Topic", "Will topic"); }
                                LineEdit {
                                    text <=> root.will-topic;
                                    placeholder-text: I18n.t("留空则不发送遗嘱", "Empty = no will");
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: I18n.t("遗嘱 Payload", "Will payload"); }
                                LineEdit {
                                    text <=> root.will-payload;
                                    placeholder-text: I18n.t("异常断开时由 Broker 代发", "Sent by broker on unexpected disconnect");
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: I18n.t("遗嘱 QoS", "Will QoS"); color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                            Select {
                                width: 56px;
                                options: ["0", "1", "2"];
                                current-index <=> root.will-qos;
                                interactive: !root.connected && !root.connecting;
                            }
                            CheckBox {
                                text: "Retain";
                                checked <=> root.will-retain;
                                enabled: !root.connected && !root.connecting;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                }
            }
        }

        if root.page == 1: VerticalLayout {
            padding: 0;
            spacing: 12px;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            Rectangle {
                border-radius: 10px;
                background: Theme.panel-bg;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalBox {
                        padding: 0;
                        spacing: 10px;
                        Text {
                            text: root.connection-name;
                            color: Theme.text-primary;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.connection-summary;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            border-radius: 11px;
                            background: Theme.badge-bg;
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.status-color;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: root.status;
                                        color: root.status-color;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Button {
                            width: 72px;
                            text: I18n.t("编辑", "Edit");
                            enabled: !root.connecting;
                            clicked => { root.edit-connection-requested(); }
                        }
                        Button {
                            width: 72px;
                            text: I18n.t("连接", "Connect");
                            enabled: !root.connected && !root.connecting;
                            clicked => { root.connect-requested(); }
                        }
                        Button {
                            width: 72px;
                            text: I18n.t("断开", "Disconnect");
                            enabled: root.connected || root.connecting;
                            clicked => { root.disconnect-requested(); }
                        }
                    }
                }
            }

            HorizontalLayout {
                padding: 0;
                spacing: 12px;
                vertical-stretch: 1;

                Rectangle {
                    width: 220px;
                    border-radius: 10px;
                    background: Theme.panel-bg;
                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;
                        Text { text: I18n.t("订阅", "Subscribe"); color: Theme.text-title; font-weight: 600; }
                        LineEdit {
                            text <=> root.sub-topic;
                            placeholder-text: "topic/filter/#";
                            enabled: root.connected;
                        }
                        HorizontalBox {
                            padding: 0;
                            spacing: 8px;
                            Text { text: "QoS"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                            Select {
                                width: 56px;
                                options: ["0", "1", "2"];
                                current-index <=> root.sub-qos;
                                interactive: root.connected;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                width: 72px;
                                text: I18n.t("订阅", "Sub");
                                enabled: root.connected;
                                clicked => { root.subscribe-requested(); }
                            }
                        }
                        Text {
                            text: root.active-sub-topic == "" ? I18n.t("点击订阅可筛选消息", "Click a subscription to filter") : I18n.t("正在筛选: ", "Filtering: ") + root.active-sub-topic;
                            color: Theme.text-faint;
                            font-size: 12px;
                            overflow: elide;
                        }
                        Rectangle {
                            background: Theme.inset-bg;
                            border-radius: 8px;
                            vertical-stretch: 1;
                            clip: true;
                            ListView {
                                for sub[index] in root.subscriptions: Rectangle {
                                    height: 44px;
                                    background: sub.selected ? Theme.sub-selected : transparent;
                                    sub-touch := TouchArea {
                                        clicked => { root.filter-subscription-requested(sub.topic); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: sub.topic;
                                                color: sub.selected ? Theme.send-topic : Theme.text-body;
                                                overflow: elide;
                                                font-family: Theme.mono-font;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "QoS " + sub.qos;
                                                color: Theme.text-muted;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: cancel-touch.has-hover ? Theme.hover-bg : transparent;
                                            y: (parent.height - self.height) / 2;
                                            Text {
                                                text: "×";
                                                color: Theme.danger;
                                                font-size: 15px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            cancel-touch := TouchArea {
                                                clicked => { root.unsubscribe-requested(index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    padding: 0;
                    spacing: 12px;
                    horizontal-stretch: 1;

                    Rectangle {
                        border-radius: 10px;
                        background: Theme.panel-bg;
                        vertical-stretch: 1;
                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalBox {
                                padding: 0;
                                spacing: 8px;
                                Text { text: I18n.t("消息", "Messages"); color: Theme.text-title; font-weight: 600; vertical-alignment: center; }
                                LineEdit {
                                    width: 148px;
                                    text <=> root.log-filter;
                                    placeholder-text: I18n.t("搜索 Topic / Payload", "Search topic / payload");
                                    edited => { root.log-filter-changed(); }
                                }
                                Select {
                                    width: 72px;
                                    options: [
                                        I18n.t("全部", "All"),
                                        I18n.t("收", "In"),
                                        I18n.t("发", "Out"),
                                        I18n.t("系统", "Sys"),
                                        I18n.t("错误", "Err"),
                                    ];
                                    current-index <=> root.log-kind-filter;
                                    activated(idx) => { root.log-filter-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Select {
                                    width: 78px;
                                    options: [
                                        I18n.t("文本", "Text"),
                                        "JSON",
                                        "Base64",
                                        "Hex",
                                    ];
                                    current-index <=> root.log-format;
                                    activated(idx) => { root.log-format-changed(); }
                                }
                                CheckBox {
                                    text: I18n.t("自动滚动", "Auto-scroll");
                                    checked <=> root.auto-scroll;
                                }
                                Button {
                                    text: I18n.t("保存", "Save");
                                    clicked => { root.save-logs-requested(); }
                                }
                                Button {
                                    text: I18n.t("清空", "Clear");
                                    clicked => { root.clear-logs-requested(); }
                                }
                            }
                            MessageList {
                                logs <=> root.logs;
                                auto-scroll <=> root.auto-scroll;
                                vertical-stretch: 1;
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 10px;
                        background: Theme.panel-bg;
                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalBox {
                                padding: 0;
                                spacing: 8px;
                                Text { text: I18n.t("发布", "Publish"); color: Theme.text-title; font-weight: 600; vertical-alignment: center; }
                                LineEdit {
                                    text <=> root.pub-topic;
                                    placeholder-text: "Topic";
                                    enabled: root.connected;
                                }
                                Select {
                                    width: 52px;
                                    options: ["0", "1", "2"];
                                    current-index <=> root.pub-qos;
                                    interactive: root.connected;
                                }
                                CheckBox {
                                    text: "Retain";
                                    checked <=> root.pub-retain;
                                    enabled: root.connected;
                                }
                                Select {
                                    width: 78px;
                                    options: [
                                        I18n.t("文本", "Text"),
                                        "JSON",
                                        "Base64",
                                        "Hex",
                                    ];
                                    current-index <=> root.pub-format;
                                    interactive: root.connected;
                                }
                                Button {
                                    width: 52px;
                                    text: I18n.t("美化", "Pretty");
                                    enabled: root.connected && root.pub-format == 1;
                                    clicked => { root.format-payload-requested(); }
                                }
                                LineEdit {
                                    width: 44px;
                                    text <=> root.timed-interval;
                                    placeholder-text: I18n.t("秒", "sec");
                                    enabled: root.connected && !root.timed-running;
                                }
                                Button {
                                    width: 72px;
                                    text: root.timed-running ? I18n.t("停止", "Stop") : I18n.t("定时", "Timed");
                                    enabled: root.connected || root.timed-running;
                                    clicked => { root.timed-toggle-requested(); }
                                }
                                Button {
                                    width: 64px;
                                    text: I18n.t("发布", "Pub");
                                    enabled: root.connected;
                                    clicked => { root.publish-requested(); }
                                }
                            }
                            TextEdit {
                                text <=> root.pub-payload;
                                placeholder-text: "Payload";
                                enabled: root.connected;
                                wrap: word-wrap;
                                font-family: Theme.mono-font;
                                height: 56px;
                            }
                        }
                    }
                 }
             }
         }
     }
}
