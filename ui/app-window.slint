import { Button, CheckBox, LineEdit, ListView, TextEdit, VerticalBox, HorizontalBox, ScrollView, Palette } from "std-widgets.slint";

export struct ConnectionEntry {
    id: string,
    name: string,
    status: string,
    status-color: color,
}

export struct Subscription {
    topic: string,
    qos: int,
    selected: bool,
}

export struct LogEntry {
    time: string,
    timestamp: string,
    kind: string,
    topic: string,
    payload: string,
}

export global Theme {
    in-out property <int> skin: 0;

    pure function pick(black: color, white: color, blue: color, green: color, purple: color) -> color {
        if (skin == 1) {
            return white;
        }
        if (skin == 2) {
            return blue;
        }
        if (skin == 3) {
            return green;
        }
        if (skin == 4) {
            return purple;
        }
        return black;
    }

    out property <color> window-bg: pick(#16181d, #e8edf3, #0f1724, #101812, #16141c);
    out property <color> panel-bg: pick(#1e2229, #ffffff, #162033, #172019, #1e1b28);
    out property <color> inset-bg: pick(#12141a, #f3f6fa, #0c1320, #0c120e, #120f18);
    out property <color> hover-bg: pick(#3a3f49, #e4eaf2, #24344f, #24352a, #342e45);
    out property <color> selected-bg: pick(#2b3240, #d7e6f8, #1d3358, #1e3a28, #3a2f52);
    out property <color> badge-bg: pick(#242830, #e7ecf3, #1b283d, #1c2a20, #2a2536);
    out property <color> text-primary: pick(#f2f4f8, #1c2430, #e8f0ff, #e8f5ea, #f0eaf8);
    out property <color> text-title: pick(#c5cad3, #334155, #b8cce8, #b7d4bc, #cbbde0);
    out property <color> text-muted: pick(#8b919a, #5b6573, #7d93b3, #7a9a80, #9789ad);
    out property <color> text-faint: pick(#6d737c, #7a8491, #5d7394, #5e7a64, #756885);
    out property <color> text-body: pick(#e4e8ef, #1c2430, #c5d6ee, #c5ddc9, #ddd2ee);
    out property <color> accent: pick(#2f6fd0, #2f6fd0, #3d8bff, #2ea043, #8b5cf6);
    out property <color> accent-fg: #ffffff;
    out property <color> muted: pick(#9aa0a6, #6b7280, #8aa0bf, #8aaa90, #a394b8);
    out property <color> recv-bg: pick(#1b2f24, #e4f6ea, #143028, #1a3324, #1b2f24);
    out property <color> recv-topic: pick(#4ecf7a, #1f8a4c, #4ecf7a, #4ecf7a, #4ecf7a);
    out property <color> recv-payload: pick(#d7e8dc, #1a3d28, #d7e8dc, #d7e8dc, #d7e8dc);
    out property <color> send-bg: pick(#1d2f4a, #e4eefc, #1a3358, #1d2f4a, #2a2450);
    out property <color> send-topic: pick(#5aa7ff, #1d5fbf, #7ab8ff, #5aa7ff, #b794f6);
    out property <color> send-payload: pick(#d5e4f7, #1a2d4a, #d5e4f7, #d5e4f7, #e8defa);
    out property <color> sys-bg: pick(#242830, #e7ecf3, #1b283d, #1c2a20, #2a2536);
    out property <color> sys-text: pick(#b8c0cc, #3d4654, #b8c0cc, #c5ddc9, #ddd2ee);
    out property <color> err-bg: pick(#3a2224, #fde8e8, #3a2224, #3a2224, #3a2224);
    out property <color> err-label: pick(#e85d5d, #c62828, #e85d5d, #e85d5d, #e85d5d);
    out property <color> err-text: pick(#f0c4c4, #7a1f1f, #f0c4c4, #f0c4c4, #f0c4c4);
    out property <color> danger: pick(#e85d5d, #c62828, #e85d5d, #e85d5d, #e85d5d);
    out property <color> sub-selected: pick(#243248, #d7e6f8, #1d3358, #1e3a28, #3a2f52);
}

component Segmented inherits Rectangle {
    in property <[string]> options: [];
    in-out property <int> current-index: 0;
    in property <bool> interactive: true;
    in property <length> item-width: 54px;

    callback activated(int);

    height: 28px;
    border-radius: 6px;
    background: Theme.inset-bg;
    width: options.length * item-width;

    HorizontalLayout {
        for opt[index] in options: Rectangle {
            width: item-width;
            border-radius: 5px;
            background: index == current-index ? Theme.accent : transparent;
            opacity: interactive ? 1 : 0.45;
            Text {
                text: opt;
                color: index == current-index ? Theme.accent-fg : Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 12px;
            }
            seg-touch := TouchArea {
                clicked => {
                    if (interactive) {
                        current-index = index;
                        activated(index);
                    }
                }
            }
        }
    }
}

component FieldLabel inherits Text {
    in property <string> caption;
    text: caption;
    color: Theme.text-muted;
    font-size: 11px;
}

component MessageList inherits Rectangle {
    in-out property <[LogEntry]> logs: [];
    in-out property <bool> auto-scroll: true;

    background: Theme.inset-bg;
    border-radius: 8px;
    clip: true;

    function scroll-to-bottom() {
        if (root.auto-scroll) {
            log-view.viewport-y = min(0px, log-view.height - log-view.viewport-height);
        }
    }

    changed auto-scroll => {
        root.scroll-to-bottom();
    }
    changed logs => {
        if (root.auto-scroll) {
            stick-timer.running = false;
            stick-timer.running = true;
        }
    }

    stick-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.scroll-to-bottom();
        }
    }

    log-view := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: max(self.height, content.preferred-height);

        changed viewport-height => {
            root.scroll-to-bottom();
        }
        changed height => {
            root.scroll-to-bottom();
        }

        content := VerticalLayout {
            width: 100%;
            height: self.preferred-height;
            alignment: start;
            spacing: 0px;
            for entry in root.logs: Rectangle {
                width: 100%;
                vertical-stretch: 0;
                height: self.preferred-height;
                background: Theme.inset-bg;
                VerticalLayout {
                    padding-top: 5px;
                    padding-bottom: 5px;
                    padding-left: 10px;
                    padding-right: 10px;
                    if entry.kind == "RECV": HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            max-width: 520px;
                            horizontal-stretch: 0;
                            border-radius: 10px;
                            background: Theme.recv-bg;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: entry.topic;
                                        color: Theme.recv-topic;
                                        font-family: "Consolas";
                                        font-size: 11px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: entry.time;
                                        color: Theme.text-faint;
                                        font-family: "Consolas";
                                        font-size: 10px;
                                    }
                                }
                                Text {
                                    text: entry.payload;
                                    color: Theme.recv-payload;
                                    wrap: word-wrap;
                                    font-family: "Consolas";
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    if entry.kind == "SEND": HorizontalLayout {
                        alignment: end;
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            max-width: 520px;
                            horizontal-stretch: 0;
                            border-radius: 10px;
                            background: Theme.send-bg;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: entry.topic;
                                        color: Theme.send-topic;
                                        font-family: "Consolas";
                                        font-size: 11px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: entry.time;
                                        color: Theme.text-faint;
                                        font-family: "Consolas";
                                        font-size: 10px;
                                    }
                                }
                                Text {
                                    text: entry.payload;
                                    color: Theme.send-payload;
                                    wrap: word-wrap;
                                    font-family: "Consolas";
                                }
                            }
                        }
                    }
                    if entry.kind != "RECV" && entry.kind != "SEND": HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            border-radius: 8px;
                            background: entry.kind == "ERR" ? Theme.err-bg : Theme.sys-bg;
                            VerticalLayout {
                                padding: 6px;
                                padding-left: 10px;
                                padding-right: 10px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    Text {
                                        text: entry.time;
                                        color: Theme.text-faint;
                                        font-family: "Consolas";
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: entry.kind == "ERR" ? "错误" : "系统";
                                        color: entry.kind == "ERR" ? Theme.err-label : Theme.muted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: entry.topic == "" ? entry.payload : entry.topic + "  " + entry.payload;
                                        color: entry.kind == "ERR" ? Theme.err-text : Theme.sys-text;
                                        wrap: word-wrap;
                                        font-family: "Consolas";
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "mqttc";
    min-width: 1480px;
    min-height: 720px;
    preferred-width: 1600px;
    preferred-height: 860px;
    background: Theme.window-bg;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    in-out property <int> page: 0;
    in-out property <string> active-connection-id: "";
    in-out property <[ConnectionEntry]> connections: [];
    in-out property <string> connection-summary: "127.0.0.1:1883";

    in-out property <string> connection-name: "";
    in-out property <string> host: "127.0.0.1";
    in-out property <string> port: "1883";
    in-out property <string> client-id: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> keep-alive: "60";
    in-out property <bool> clean-session: true;
    in-out property <string> connect-timeout: "10";
    in-out property <string> will-topic: "";
    in-out property <string> will-payload: "";
    in-out property <int> will-qos: 0;
    in-out property <bool> will-retain: false;
    in-out property <bool> ssl: false;
    in-out property <bool> ssl-verify: true;
    in-out property <string> ssl-ca: "";
    in-out property <string> ssl-cert: "";
    in-out property <string> ssl-key: "";
    in-out property <string> status: "未连接";
    in-out property <color> status-color: #9aa0a6;
    in-out property <bool> connected: false;
    in-out property <bool> connecting: false;

    in-out property <string> sub-topic: "mqttc/mvp/#";
    in-out property <int> sub-qos: 0;
    in-out property <[Subscription]> subscriptions: [];
    in-out property <string> active-sub-topic: "";

    in-out property <string> pub-topic: "mqttc/mvp/hello";
    in-out property <string> pub-payload: "hello from mqttc";
    in-out property <int> pub-qos: 0;
    in-out property <bool> pub-retain: false;
    in-out property <int> pub-format: 0;
    in-out property <string> timed-interval: "5";
    in-out property <bool> timed-running: false;

    in-out property <[LogEntry]> logs: [];
    in-out property <int> log-format: 0;
    in-out property <bool> auto-scroll: true;
    in-out property <string> log-filter: "";
    in-out property <int> log-kind-filter: 0;
    in-out property <int> skin <=> Theme.skin;

    init => {
        Palette.color-scheme = skin == 1 ? ColorScheme.light : ColorScheme.dark;
    }

    changed skin => {
        Palette.color-scheme = skin == 1 ? ColorScheme.light : ColorScheme.dark;
        root.skin-changed();
    }

    callback new-connection-requested();
    callback select-connection-requested(string);
    callback delete-connection-requested(string);
    callback edit-connection-requested();
    callback back-to-session-requested();
    callback connect-requested();
    callback disconnect-requested();
    callback subscribe-requested();
    callback unsubscribe-requested(int);
    callback filter-subscription-requested(string);
    callback publish-requested();
    callback format-payload-requested();
    callback generate-client-id-requested();
    callback timed-toggle-requested();
    callback log-format-changed();
    callback log-filter-changed();
    callback save-logs-requested();
    callback clear-logs-requested();
    callback skin-changed();

    HorizontalBox {
        padding: 12px;
        spacing: 12px;

        Rectangle {
            width: 248px;
            border-radius: 10px;
            background: Theme.panel-bg;
            VerticalBox {
                padding: 10px;
                spacing: 8px;
                HorizontalBox {
                    spacing: 6px;
                    Text { text: "连接"; color: Theme.text-title; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 40px;
                        text: "+";
                        clicked => { root.new-connection-requested(); }
                    }
                }
                Rectangle {
                    background: Theme.inset-bg;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    clip: true;
                    ListView {
                        for conn in root.connections: Rectangle {
                            height: 54px;
                            background: conn.id == root.active-connection-id ? Theme.selected-bg : transparent;
                            row-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.select-connection-requested(conn.id); }
                            }
                            HorizontalLayout {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                padding: 8px;
                                spacing: 8px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: conn.status-color;
                                    y: (parent.height - self.height) / 2;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: conn.name;
                                        color: Theme.text-body;
                                        overflow: elide;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: conn.status;
                                        color: conn.status-color;
                                        font-size: 11px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: del-touch.has-hover ? Theme.hover-bg : transparent;
                                    y: (parent.height - self.height) / 2;
                                    Text {
                                        text: "×";
                                        color: Theme.danger;
                                        font-size: 15px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    del-touch := TouchArea {
                                        clicked => { root.delete-connection-requested(conn.id); }
                                    }
                                }
                            }
                        }
                    }
                }
                Text { text: "皮肤"; color: Theme.text-title; font-weight: 600; }
                Segmented {
                    options: ["黑", "白", "蓝", "绿", "紫"];
                    item-width: 40px;
                    current-index <=> root.skin;
                }
            }
        }

        if root.page == 0: Rectangle {
            border-radius: 10px;
            background: Theme.panel-bg;
            horizontal-stretch: 1;
            VerticalBox {
                padding: 16px;
                spacing: 12px;
                HorizontalBox {
                    spacing: 10px;
                    Text {
                        text: "连接配置";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.connection-name;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 88px;
                        text: "返回会话";
                        clicked => { root.back-to-session-requested(); }
                    }
                    Button {
                        width: 88px;
                        text: "连接";
                        enabled: !root.connected && !root.connecting;
                        clicked => { root.connect-requested(); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalBox {
                        padding-right: 8px;
                        spacing: 14px;
                        Text { text: "基础信息"; color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "名称"; }
                                LineEdit {
                                    text <=> root.connection-name;
                                    placeholder-text: "连接名称";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "主机"; }
                                LineEdit {
                                    text <=> root.host;
                                    placeholder-text: "127.0.0.1";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                width: 100px;
                                FieldLabel { caption: "端口"; }
                                LineEdit {
                                    text <=> root.port;
                                    placeholder-text: "1883";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "Client ID"; }
                                HorizontalBox {
                                    spacing: 6px;
                                    LineEdit {
                                        text <=> root.client-id;
                                        placeholder-text: "空则自动生成";
                                        enabled: !root.connected && !root.connecting;
                                    }
                                    Button {
                                        width: 52px;
                                        text: "生成";
                                        enabled: !root.connected && !root.connecting;
                                        clicked => { root.generate-client-id-requested(); }
                                    }
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "用户名"; }
                                LineEdit {
                                    text <=> root.username;
                                    placeholder-text: "可选，空则匿名";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "密码"; }
                                LineEdit {
                                    text <=> root.password;
                                    placeholder-text: "可选";
                                    input-type: InputType.password;
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                        }
                        Text { text: "高级参数"; color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                width: 140px;
                                FieldLabel { caption: "Keep Alive (秒)"; }
                                LineEdit {
                                    text <=> root.keep-alive;
                                    placeholder-text: "60";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                width: 140px;
                                FieldLabel { caption: "连接超时 (秒)"; }
                                LineEdit {
                                    text <=> root.connect-timeout;
                                    placeholder-text: "10";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                alignment: end;
                                CheckBox {
                                    text: "Clean Session";
                                    checked <=> root.clean-session;
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Text { text: "SSL / TLS"; color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            CheckBox {
                                text: "启用 SSL";
                                checked <=> root.ssl;
                                enabled: !root.connected && !root.connecting;
                                toggled => {
                                    if (root.ssl && root.port == "1883") {
                                        root.port = "8883";
                                    }
                                    if (!root.ssl && root.port == "8883") {
                                        root.port = "1883";
                                    }
                                }
                            }
                            CheckBox {
                                text: "校验服务器证书";
                                checked <=> root.ssl-verify;
                                enabled: root.ssl && !root.connected && !root.connecting;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        if root.ssl: VerticalBox {
                            spacing: 10px;
                            HorizontalBox {
                                spacing: 10px;
                                VerticalBox {
                                    spacing: 4px;
                                    FieldLabel { caption: "CA 证书路径"; }
                                    LineEdit {
                                        text <=> root.ssl-ca;
                                        placeholder-text: "可选，空则使用系统 CA";
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                            }
                            HorizontalBox {
                                spacing: 10px;
                                VerticalBox {
                                    spacing: 4px;
                                    FieldLabel { caption: "客户端证书"; }
                                    LineEdit {
                                        text <=> root.ssl-cert;
                                        placeholder-text: "可选，双向认证时填写";
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                                VerticalBox {
                                    spacing: 4px;
                                    FieldLabel { caption: "客户端私钥"; }
                                    LineEdit {
                                        text <=> root.ssl-key;
                                        placeholder-text: "可选，与证书成对";
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                            }
                            Text {
                                text: "端口常用 8883。关闭校验仅用于自签证书调试。";
                                color: Theme.text-faint;
                                font-size: 11px;
                            }
                        }
                        Text { text: "遗嘱消息 (Last Will)"; color: Theme.text-title; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "遗嘱 Topic"; }
                                LineEdit {
                                    text <=> root.will-topic;
                                    placeholder-text: "留空则不发送遗嘱";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "遗嘱 Payload"; }
                                LineEdit {
                                    text <=> root.will-payload;
                                    placeholder-text: "异常断开时由 Broker 代发";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "遗嘱 QoS"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                            Segmented {
                                options: ["0", "1", "2"];
                                item-width: 42px;
                                current-index <=> root.will-qos;
                                interactive: !root.connected && !root.connecting;
                            }
                            CheckBox {
                                text: "Retain";
                                checked <=> root.will-retain;
                                enabled: !root.connected && !root.connecting;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                }
            }
        }

        if root.page == 1: VerticalBox {
            spacing: 12px;
            horizontal-stretch: 1;

            Rectangle {
                border-radius: 10px;
                background: Theme.panel-bg;
                VerticalBox {
                    padding: 12px;
                    spacing: 6px;
                    HorizontalBox {
                        spacing: 10px;
                        Text {
                            text: root.connection-name;
                            color: Theme.text-primary;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.connection-summary;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            border-radius: 11px;
                            background: Theme.badge-bg;
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.status-color;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: root.status;
                                        color: root.status-color;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Button {
                            width: 72px;
                            text: "编辑";
                            enabled: !root.connecting;
                            clicked => { root.edit-connection-requested(); }
                        }
                        Button {
                            width: 72px;
                            text: "连接";
                            enabled: !root.connected && !root.connecting;
                            clicked => { root.connect-requested(); }
                        }
                        Button {
                            width: 72px;
                            text: "断开";
                            enabled: root.connected || root.connecting;
                            clicked => { root.disconnect-requested(); }
                        }
                    }
                }
            }

            HorizontalBox {
                spacing: 12px;
                vertical-stretch: 1;

                Rectangle {
                    width: 260px;
                    border-radius: 10px;
                    background: Theme.panel-bg;
                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;
                        Text { text: "订阅"; color: Theme.text-title; font-weight: 600; }
                        LineEdit {
                            text <=> root.sub-topic;
                            placeholder-text: "topic/filter/#";
                            enabled: root.connected;
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "QoS"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                            Segmented {
                                options: ["0", "1", "2"];
                                item-width: 42px;
                                current-index <=> root.sub-qos;
                                interactive: root.connected;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                width: 72px;
                                text: "订阅";
                                enabled: root.connected;
                                clicked => { root.subscribe-requested(); }
                            }
                        }
                        Text {
                            text: root.active-sub-topic == "" ? "点击订阅可筛选消息" : "正在筛选: " + root.active-sub-topic;
                            color: Theme.text-faint;
                            font-size: 11px;
                            overflow: elide;
                        }
                        Rectangle {
                            background: Theme.inset-bg;
                            border-radius: 6px;
                            vertical-stretch: 1;
                            clip: true;
                            ListView {
                                for sub[index] in root.subscriptions: Rectangle {
                                    height: 44px;
                                    background: sub.selected ? Theme.sub-selected : transparent;
                                    sub-touch := TouchArea {
                                        clicked => { root.filter-subscription-requested(sub.topic); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: sub.topic;
                                                color: sub.selected ? Theme.send-topic : Theme.text-body;
                                                overflow: elide;
                                                font-family: "Consolas";
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "QoS " + sub.qos;
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: cancel-touch.has-hover ? Theme.hover-bg : transparent;
                                            y: (parent.height - self.height) / 2;
                                            Text {
                                                text: "×";
                                                color: Theme.danger;
                                                font-size: 15px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            cancel-touch := TouchArea {
                                                clicked => { root.unsubscribe-requested(index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalBox {
                    spacing: 8px;
                    horizontal-stretch: 1;

                    Rectangle {
                        border-radius: 10px;
                        background: Theme.panel-bg;
                        vertical-stretch: 1;
                        VerticalBox {
                            padding: 8px;
                            spacing: 6px;
                            HorizontalBox {
                                spacing: 8px;
                                Text { text: "消息"; color: Theme.text-title; font-weight: 600; vertical-alignment: center; }
                                LineEdit {
                                    width: 160px;
                                    text <=> root.log-filter;
                                    placeholder-text: "搜索 Topic / Payload";
                                    edited => { root.log-filter-changed(); }
                                }
                                Segmented {
                                    options: ["全部", "收", "发", "系统", "错误"];
                                    item-width: 42px;
                                    current-index <=> root.log-kind-filter;
                                    activated(idx) => { root.log-filter-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Segmented {
                                    options: ["文本", "JSON", "Base64", "Hex"];
                                    item-width: 54px;
                                    current-index <=> root.log-format;
                                    activated(idx) => { root.log-format-changed(); }
                                }
                                CheckBox {
                                    text: "自动滚动";
                                    checked <=> root.auto-scroll;
                                }
                                Button {
                                    text: "保存";
                                    clicked => { root.save-logs-requested(); }
                                }
                                Button {
                                    text: "清空";
                                    clicked => { root.clear-logs-requested(); }
                                }
                            }
                            MessageList {
                                logs <=> root.logs;
                                auto-scroll <=> root.auto-scroll;
                                vertical-stretch: 1;
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 10px;
                        background: Theme.panel-bg;
                        VerticalBox {
                            padding: 8px;
                            spacing: 6px;
                            HorizontalBox {
                                spacing: 6px;
                                Text { text: "发布"; color: Theme.text-title; font-weight: 600; vertical-alignment: center; }
                                LineEdit {
                                    text <=> root.pub-topic;
                                    placeholder-text: "Topic";
                                    enabled: root.connected;
                                }
                                Segmented {
                                    options: ["0", "1", "2"];
                                    item-width: 32px;
                                    current-index <=> root.pub-qos;
                                    interactive: root.connected;
                                }
                                CheckBox {
                                    text: "Retain";
                                    checked <=> root.pub-retain;
                                    enabled: root.connected;
                                }
                                Segmented {
                                    options: ["文本", "JSON", "Base64", "Hex"];
                                    item-width: 48px;
                                    current-index <=> root.pub-format;
                                    interactive: root.connected;
                                }
                                Button {
                                    width: 48px;
                                    text: "美化";
                                    enabled: root.connected && root.pub-format == 1;
                                    clicked => { root.format-payload-requested(); }
                                }
                                LineEdit {
                                    width: 44px;
                                    text <=> root.timed-interval;
                                    placeholder-text: "秒";
                                    enabled: root.connected && !root.timed-running;
                                }
                                Button {
                                    width: 72px;
                                    text: root.timed-running ? "停止" : "定时";
                                    enabled: root.connected || root.timed-running;
                                    clicked => { root.timed-toggle-requested(); }
                                }
                                Button {
                                    width: 64px;
                                    text: "发布";
                                    enabled: root.connected;
                                    clicked => { root.publish-requested(); }
                                }
                            }
                            TextEdit {
                                text <=> root.pub-payload;
                                placeholder-text: "Payload";
                                enabled: root.connected;
                                wrap: word-wrap;
                                font-family: "Consolas";
                                height: 56px;
                            }
                        }
                    }
                 }
             }
         }
     }
}
