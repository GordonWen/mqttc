import { Button, CheckBox, LineEdit, ListView, TextEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export struct ConnectionEntry {
    id: string,
    name: string,
    status: string,
    status-color: color,
}

export struct Subscription {
    topic: string,
    qos: int,
    selected: bool,
}

export struct LogEntry {
    time: string,
    timestamp: string,
    kind: string,
    topic: string,
    payload: string,
}

component Segmented inherits Rectangle {
    in property <[string]> options: [];
    in-out property <int> current-index: 0;
    in property <bool> interactive: true;
    in property <length> item-width: 54px;

    callback activated(int);

    height: 28px;
    border-radius: 6px;
    background: #12141a;
    width: options.length * item-width;

    HorizontalLayout {
        for opt[index] in options: Rectangle {
            width: item-width;
            border-radius: 5px;
            background: index == current-index ? #2f6fd0 : transparent;
            opacity: interactive ? 1 : 0.45;
            Text {
                text: opt;
                color: index == current-index ? #ffffff : #9aa0a6;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 12px;
            }
            seg-touch := TouchArea {
                clicked => {
                    if (interactive) {
                        current-index = index;
                        activated(index);
                    }
                }
            }
        }
    }
}

component FieldLabel inherits Text {
    in property <string> caption;
    text: caption;
    color: #8b919a;
    font-size: 11px;
}

component MessageList inherits Rectangle {
    in-out property <[LogEntry]> logs: [];
    in-out property <bool> auto-scroll: true;
    in-out property <length> log-scroll-y: 0px;

    background: #12141a;
    border-radius: 8px;
    clip: true;

    log-view := ListView {
        viewport-y <=> root.log-scroll-y;
        for entry in root.logs: Rectangle {
            min-height: 36px;
            background: #12141a;
            VerticalLayout {
                padding-top: 5px;
                padding-bottom: 5px;
                padding-left: 10px;
                padding-right: 10px;
                if entry.kind == "RECV": HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        max-width: 520px;
                        horizontal-stretch: 0;
                        border-radius: 10px;
                        background: #1b2f24;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: entry.topic;
                                    color: #4ecf7a;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: entry.time;
                                    color: #6d737c;
                                    font-family: "Consolas";
                                    font-size: 10px;
                                }
                            }
                            Text {
                                text: entry.payload;
                                color: #d7e8dc;
                                wrap: word-wrap;
                                font-family: "Consolas";
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                if entry.kind == "SEND": HorizontalLayout {
                    alignment: end;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        max-width: 520px;
                        horizontal-stretch: 0;
                        border-radius: 10px;
                        background: #1d2f4a;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: entry.topic;
                                    color: #5aa7ff;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: entry.time;
                                    color: #6d737c;
                                    font-family: "Consolas";
                                    font-size: 10px;
                                }
                            }
                            Text {
                                text: entry.payload;
                                color: #d5e4f7;
                                wrap: word-wrap;
                                font-family: "Consolas";
                            }
                        }
                    }
                }
                if entry.kind != "RECV" && entry.kind != "SEND": HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: 8px;
                        background: entry.kind == "ERR" ? #3a2224 : #242830;
                        VerticalLayout {
                            padding: 6px;
                            padding-left: 10px;
                            padding-right: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text {
                                    text: entry.time;
                                    color: #6d737c;
                                    font-family: "Consolas";
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: entry.kind == "ERR" ? "错误" : "系统";
                                    color: entry.kind == "ERR" ? #e85d5d : #9aa0a6;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: entry.topic == "" ? entry.payload : entry.topic + "  " + entry.payload;
                                    color: entry.kind == "ERR" ? #f0c4c4 : #b8c0cc;
                                    wrap: word-wrap;
                                    font-family: "Consolas";
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    states [
        auto-scrolling when root.auto-scroll: {
            log-scroll-y: min(0px, log-view.visible-height - log-view.viewport-height);
        }
    ]
}

export component AppWindow inherits Window {
    title: "mqttc";
    min-width: 1180px;
    min-height: 720px;
    preferred-width: 1360px;
    preferred-height: 860px;
    background: #16181d;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    in-out property <int> page: 0;
    in-out property <string> active-connection-id: "";
    in-out property <[ConnectionEntry]> connections: [];
    in-out property <string> connection-summary: "127.0.0.1:1883";

    in-out property <string> connection-name: "";
    in-out property <string> host: "127.0.0.1";
    in-out property <string> port: "1883";
    in-out property <string> client-id: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> keep-alive: "60";
    in-out property <bool> clean-session: true;
    in-out property <string> connect-timeout: "10";
    in-out property <string> will-topic: "";
    in-out property <string> will-payload: "";
    in-out property <int> will-qos: 0;
    in-out property <bool> will-retain: false;
    in-out property <bool> ssl: false;
    in-out property <bool> ssl-verify: true;
    in-out property <string> ssl-ca: "";
    in-out property <string> ssl-cert: "";
    in-out property <string> ssl-key: "";
    in-out property <string> status: "未连接";
    in-out property <color> status-color: #9aa0a6;
    in-out property <bool> connected: false;
    in-out property <bool> connecting: false;

    in-out property <string> sub-topic: "mqttc/mvp/#";
    in-out property <int> sub-qos: 0;
    in-out property <[Subscription]> subscriptions: [];
    in-out property <string> active-sub-topic: "";

    in-out property <string> pub-topic: "mqttc/mvp/hello";
    in-out property <string> pub-payload: "hello from mqttc";
    in-out property <int> pub-qos: 0;
    in-out property <bool> pub-retain: false;
    in-out property <int> pub-format: 0;
    in-out property <string> timed-interval: "5";
    in-out property <bool> timed-running: false;

    in-out property <[LogEntry]> logs: [];
    in-out property <int> log-format: 0;
    in-out property <bool> auto-scroll: true;
    in-out property <string> log-filter: "";
    in-out property <int> log-kind-filter: 0;
    in-out property <length> log-scroll-y: 0px;

    callback new-connection-requested();
    callback select-connection-requested(string);
    callback delete-connection-requested(string);
    callback edit-connection-requested();
    callback back-to-session-requested();
    callback connect-requested();
    callback disconnect-requested();
    callback subscribe-requested();
    callback unsubscribe-requested(int);
    callback filter-subscription-requested(string);
    callback publish-requested();
    callback format-payload-requested();
    callback generate-client-id-requested();
    callback timed-toggle-requested();
    callback log-format-changed();
    callback log-filter-changed();
    callback save-logs-requested();
    callback clear-logs-requested();

    HorizontalBox {
        padding: 12px;
        spacing: 12px;

        Rectangle {
            width: 248px;
            border-radius: 10px;
            background: #1e2229;
            VerticalBox {
                padding: 10px;
                spacing: 8px;
                HorizontalBox {
                    spacing: 6px;
                    Text { text: "连接"; color: #c5cad3; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 40px;
                        text: "+";
                        clicked => { root.new-connection-requested(); }
                    }
                }
                Rectangle {
                    background: #12141a;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    clip: true;
                    ListView {
                        for conn in root.connections: Rectangle {
                            height: 54px;
                            background: conn.id == root.active-connection-id ? #2b3240 : transparent;
                            row-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.select-connection-requested(conn.id); }
                            }
                            HorizontalLayout {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                padding: 8px;
                                spacing: 8px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: conn.status-color;
                                    y: (parent.height - self.height) / 2;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: conn.name;
                                        color: #e4e8ef;
                                        overflow: elide;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: conn.status;
                                        color: conn.status-color;
                                        font-size: 11px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: del-touch.has-hover ? #3a3f49 : transparent;
                                    y: (parent.height - self.height) / 2;
                                    Text {
                                        text: "×";
                                        color: #e85d5d;
                                        font-size: 15px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    del-touch := TouchArea {
                                        clicked => { root.delete-connection-requested(conn.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.page == 0: Rectangle {
            border-radius: 10px;
            background: #1e2229;
            horizontal-stretch: 1;
            VerticalBox {
                padding: 16px;
                spacing: 12px;
                HorizontalBox {
                    spacing: 10px;
                    Text {
                        text: "连接配置";
                        color: #f2f4f8;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.connection-name;
                        color: #8b919a;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        width: 88px;
                        text: "返回会话";
                        clicked => { root.back-to-session-requested(); }
                    }
                    Button {
                        width: 88px;
                        text: "连接";
                        enabled: !root.connected && !root.connecting;
                        clicked => { root.connect-requested(); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalBox {
                        padding-right: 8px;
                        spacing: 14px;
                        Text { text: "基础信息"; color: #c5cad3; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "名称"; }
                                LineEdit {
                                    text <=> root.connection-name;
                                    placeholder-text: "连接名称";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "主机"; }
                                LineEdit {
                                    text <=> root.host;
                                    placeholder-text: "127.0.0.1";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                width: 100px;
                                FieldLabel { caption: "端口"; }
                                LineEdit {
                                    text <=> root.port;
                                    placeholder-text: "1883";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "Client ID"; }
                                HorizontalBox {
                                    spacing: 6px;
                                    LineEdit {
                                        text <=> root.client-id;
                                        placeholder-text: "空则自动生成";
                                        enabled: !root.connected && !root.connecting;
                                    }
                                    Button {
                                        width: 52px;
                                        text: "生成";
                                        enabled: !root.connected && !root.connecting;
                                        clicked => { root.generate-client-id-requested(); }
                                    }
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "用户名"; }
                                LineEdit {
                                    text <=> root.username;
                                    placeholder-text: "可选，空则匿名";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "密码"; }
                                LineEdit {
                                    text <=> root.password;
                                    placeholder-text: "可选";
                                    input-type: InputType.password;
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                        }
                        Text { text: "高级参数"; color: #c5cad3; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                width: 140px;
                                FieldLabel { caption: "Keep Alive (秒)"; }
                                LineEdit {
                                    text <=> root.keep-alive;
                                    placeholder-text: "60";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                width: 140px;
                                FieldLabel { caption: "连接超时 (秒)"; }
                                LineEdit {
                                    text <=> root.connect-timeout;
                                    placeholder-text: "10";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                alignment: end;
                                CheckBox {
                                    text: "Clean Session";
                                    checked <=> root.clean-session;
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Text { text: "SSL / TLS"; color: #c5cad3; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            CheckBox {
                                text: "启用 SSL";
                                checked <=> root.ssl;
                                enabled: !root.connected && !root.connecting;
                                toggled => {
                                    if (root.ssl && root.port == "1883") {
                                        root.port = "8883";
                                    }
                                    if (!root.ssl && root.port == "8883") {
                                        root.port = "1883";
                                    }
                                }
                            }
                            CheckBox {
                                text: "校验服务器证书";
                                checked <=> root.ssl-verify;
                                enabled: root.ssl && !root.connected && !root.connecting;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        if root.ssl: VerticalBox {
                            spacing: 10px;
                            HorizontalBox {
                                spacing: 10px;
                                VerticalBox {
                                    spacing: 4px;
                                    FieldLabel { caption: "CA 证书路径"; }
                                    LineEdit {
                                        text <=> root.ssl-ca;
                                        placeholder-text: "可选，空则使用系统 CA";
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                            }
                            HorizontalBox {
                                spacing: 10px;
                                VerticalBox {
                                    spacing: 4px;
                                    FieldLabel { caption: "客户端证书"; }
                                    LineEdit {
                                        text <=> root.ssl-cert;
                                        placeholder-text: "可选，双向认证时填写";
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                                VerticalBox {
                                    spacing: 4px;
                                    FieldLabel { caption: "客户端私钥"; }
                                    LineEdit {
                                        text <=> root.ssl-key;
                                        placeholder-text: "可选，与证书成对";
                                        enabled: !root.connected && !root.connecting;
                                    }
                                }
                            }
                            Text {
                                text: "端口常用 8883。关闭校验仅用于自签证书调试。";
                                color: #6d737c;
                                font-size: 11px;
                            }
                        }
                        Text { text: "遗嘱消息 (Last Will)"; color: #c5cad3; font-weight: 600; }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "遗嘱 Topic"; }
                                LineEdit {
                                    text <=> root.will-topic;
                                    placeholder-text: "留空则不发送遗嘱";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                            VerticalBox {
                                spacing: 4px;
                                FieldLabel { caption: "遗嘱 Payload"; }
                                LineEdit {
                                    text <=> root.will-payload;
                                    placeholder-text: "异常断开时由 Broker 代发";
                                    enabled: !root.connected && !root.connecting;
                                }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "遗嘱 QoS"; color: #8b919a; font-size: 11px; vertical-alignment: center; }
                            Segmented {
                                options: ["0", "1", "2"];
                                item-width: 42px;
                                current-index <=> root.will-qos;
                                interactive: !root.connected && !root.connecting;
                            }
                            CheckBox {
                                text: "Retain";
                                checked <=> root.will-retain;
                                enabled: !root.connected && !root.connecting;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                }
            }
        }

        if root.page == 1: VerticalBox {
            spacing: 12px;
            horizontal-stretch: 1;

            Rectangle {
                border-radius: 10px;
                background: #1e2229;
                VerticalBox {
                    padding: 12px;
                    spacing: 6px;
                    HorizontalBox {
                        spacing: 10px;
                        Text {
                            text: root.connection-name;
                            color: #f2f4f8;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.connection-summary;
                            color: #8b919a;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            border-radius: 11px;
                            background: #242830;
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.status-color;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: root.status;
                                        color: root.status-color;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Button {
                            width: 72px;
                            text: "编辑";
                            enabled: !root.connecting;
                            clicked => { root.edit-connection-requested(); }
                        }
                        Button {
                            width: 72px;
                            text: "连接";
                            enabled: !root.connected && !root.connecting;
                            clicked => { root.connect-requested(); }
                        }
                        Button {
                            width: 72px;
                            text: "断开";
                            enabled: root.connected || root.connecting;
                            clicked => { root.disconnect-requested(); }
                        }
                    }
                }
            }

            HorizontalBox {
                spacing: 12px;
                vertical-stretch: 1;

                Rectangle {
                    width: 260px;
                    border-radius: 10px;
                    background: #1e2229;
                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;
                        Text { text: "订阅"; color: #c5cad3; font-weight: 600; }
                        LineEdit {
                            text <=> root.sub-topic;
                            placeholder-text: "topic/filter/#";
                            enabled: root.connected;
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "QoS"; color: #8b919a; font-size: 11px; vertical-alignment: center; }
                            Segmented {
                                options: ["0", "1", "2"];
                                item-width: 42px;
                                current-index <=> root.sub-qos;
                                interactive: root.connected;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button {
                                width: 72px;
                                text: "订阅";
                                enabled: root.connected;
                                clicked => { root.subscribe-requested(); }
                            }
                        }
                        Text {
                            text: root.active-sub-topic == "" ? "点击订阅可筛选消息" : "正在筛选: " + root.active-sub-topic;
                            color: #6d737c;
                            font-size: 11px;
                            overflow: elide;
                        }
                        Rectangle {
                            background: #12141a;
                            border-radius: 6px;
                            vertical-stretch: 1;
                            clip: true;
                            ListView {
                                for sub[index] in root.subscriptions: Rectangle {
                                    height: 44px;
                                    background: sub.selected ? #243248 : transparent;
                                    sub-touch := TouchArea {
                                        clicked => { root.filter-subscription-requested(sub.topic); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: sub.topic;
                                                color: sub.selected ? #5aa7ff : #d7dde6;
                                                overflow: elide;
                                                font-family: "Consolas";
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "QoS " + sub.qos;
                                                color: #8b919a;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: cancel-touch.has-hover ? #3a3f49 : transparent;
                                            y: (parent.height - self.height) / 2;
                                            Text {
                                                text: "×";
                                                color: #e85d5d;
                                                font-size: 15px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            cancel-touch := TouchArea {
                                                clicked => { root.unsubscribe-requested(index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalBox {
                    spacing: 8px;
                    horizontal-stretch: 1;

                    Rectangle {
                        border-radius: 10px;
                        background: #1e2229;
                        vertical-stretch: 1;
                        VerticalBox {
                            padding: 8px;
                            spacing: 6px;
                            HorizontalBox {
                                spacing: 8px;
                                Text { text: "消息"; color: #c5cad3; font-weight: 600; vertical-alignment: center; }
                                LineEdit {
                                    width: 160px;
                                    text <=> root.log-filter;
                                    placeholder-text: "搜索 Topic / Payload";
                                    edited => { root.log-filter-changed(); }
                                }
                                Segmented {
                                    options: ["全部", "收", "发", "系统", "错误"];
                                    item-width: 42px;
                                    current-index <=> root.log-kind-filter;
                                    activated(idx) => { root.log-filter-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Segmented {
                                    options: ["文本", "JSON", "Base64", "Hex"];
                                    item-width: 54px;
                                    current-index <=> root.log-format;
                                    activated(idx) => { root.log-format-changed(); }
                                }
                                CheckBox {
                                    text: "自动滚动";
                                    checked <=> root.auto-scroll;
                                }
                                Button {
                                    text: "保存";
                                    clicked => { root.save-logs-requested(); }
                                }
                                Button {
                                    text: "清空";
                                    clicked => { root.clear-logs-requested(); }
                                }
                            }
                            MessageList {
                                logs <=> root.logs;
                                auto-scroll <=> root.auto-scroll;
                                log-scroll-y <=> root.log-scroll-y;
                                vertical-stretch: 1;
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 10px;
                        background: #1e2229;
                        VerticalBox {
                            padding: 8px;
                            spacing: 6px;
                            HorizontalBox {
                                spacing: 6px;
                                Text { text: "发布"; color: #c5cad3; font-weight: 600; vertical-alignment: center; }
                                LineEdit {
                                    text <=> root.pub-topic;
                                    placeholder-text: "Topic";
                                    enabled: root.connected;
                                }
                                Segmented {
                                    options: ["0", "1", "2"];
                                    item-width: 32px;
                                    current-index <=> root.pub-qos;
                                    interactive: root.connected;
                                }
                                CheckBox {
                                    text: "Retain";
                                    checked <=> root.pub-retain;
                                    enabled: root.connected;
                                }
                                Segmented {
                                    options: ["文本", "JSON", "Base64", "Hex"];
                                    item-width: 48px;
                                    current-index <=> root.pub-format;
                                    interactive: root.connected;
                                }
                                Button {
                                    width: 48px;
                                    text: "美化";
                                    enabled: root.connected && root.pub-format == 1;
                                    clicked => { root.format-payload-requested(); }
                                }
                                LineEdit {
                                    width: 44px;
                                    text <=> root.timed-interval;
                                    placeholder-text: "秒";
                                    enabled: root.connected && !root.timed-running;
                                }
                                Button {
                                    width: 72px;
                                    text: root.timed-running ? "停止" : "定时";
                                    enabled: root.connected || root.timed-running;
                                    clicked => { root.timed-toggle-requested(); }
                                }
                                Button {
                                    width: 64px;
                                    text: "发布";
                                    enabled: root.connected;
                                    clicked => { root.publish-requested(); }
                                }
                            }
                            TextEdit {
                                text <=> root.pub-payload;
                                placeholder-text: "Payload";
                                enabled: root.connected;
                                wrap: word-wrap;
                                font-family: "Consolas";
                                height: 56px;
                            }
                        }
                    }
                 }
             }
         }
     }
}
